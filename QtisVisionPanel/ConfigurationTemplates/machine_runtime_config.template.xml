    <TriggerSchedulingMode>VirtualConveyor</TriggerSchedulingMode>
    <ProductPhotocellSignalCode>IN_PRODUCT_PHOTOCELL</ProductPhotocellSignalCode>
    <ExternalTriggerEnableSignalCode>IN_EXTERNAL_TRIGGER_ENABLE</ExternalTriggerEnableSignalCode>
    <CameraTriggerSignalCode>OUT_CAMERA_TOP_TRIGGER</CameraTriggerSignalCode>
    <TopLightingSignalCode>OUT_CAMERA_TOP_TRIGGER</TopLightingSignalCode>
    <SideLightingSignalCode>OUT_CAMERA_SIDE_TRIGGER</SideLightingSignalCode>
    <RejectSignalCode>OUT_REJECT_SOLENOID</RejectSignalCode>
    <GeneralAlarmSignalCode>OUT_GENERAL_ALARM</GeneralAlarmSignalCode>
    <MainEncoderAxisCode>ENC_CONVEYOR_MAIN</MainEncoderAxisCode>
    <HeartbeatOutputSignalCode>OUT_HEARTBEAT</HeartbeatOutputSignalCode>
