<Application x:Class="QtisVisionPanel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QtisVisionPanel" 
             xmlns:converters="clr-namespace:QtisVisionPanel.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors.xaml"/>
                <ResourceDictionary Source="/Theme/Controls.xaml"/>
                <ResourceDictionary Source="/Resources/InspectionIcons.xaml"/>

            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/> 
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
            <converters:StatusColorConverter x:Key="StatusColorConverter"/>
            <converters:BusyStatusConverter x:Key="BusyStatusConverter"/>
            <converters:BoolToYesNoConverter x:Key="BoolToYesNoConverter"/>
            <converters:RecipeTypeAbbreviationConverter x:Key="RecipeTypeAbbreviationConverter"/>
            <converters:MeasurementLabelConverter x:Key="MeasurementLabelConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:RecipeStatusToBorderColorConverter x:Key="RecipeStatusToBorderColorConverter"/>
            <converters:RecipeStatusToColorConverter x:Key="RecipeStatusToColorConverter"/>
            <converters:RecipeStatusToIconColorConverter x:Key="RecipeStatusToIconColorConverter"/>
            <converters:RecipeStatusToIconConverter x:Key="RecipeStatusToIconConverter"/>
            <converters:RecipeImagePathConverter x:Key="RecipeImagePathConverter"/>
            <converters:StatusToIconVisibilityConverter x:Key="StatusToIconVisibilityConverter"/>
            <converters:ProductionStatusConverter x:Key="ProductionStatusConverter"/>
            <converters:RecipeTypeToVisibilityConverter x:Key="RecipeTypeToVisibilityConverter"/>
            <converters:MachineTypeToVisibilityConverter x:Key="MachineTypeToVisibilityConverter"/>
            <converters:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:AlarmLevelToColorConverter x:Key="AlarmLevelToColorConverter"/>
            <converters:AlarmLevelToIconConverter x:Key="AlarmLevelToIconConverter"/>
            <converters:MachinestatusToColorConverter x:Key="MachinestatusToColorConverter"/>
            <converters:MachinestatusToIconConverter x:Key="MachinestatusToIconConverter"/>
            <converters:MachineStatusToSpinBoolConverter x:Key="MachineStatusToSpinBoolConverter"/>
            <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
            <converters:BooleanToAlarmStatusConverter x:Key="BooleanToAlarmStatusConverter"/>
            <converters:AlarmTypeToStringConverter x:Key="AlarmTypeToStringConverter"/>
            <converters:ListContainsConverter x:Key="ListContainsConverter"/>
            <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
            <converters:PercentageToWidthConverter x:Key="PercentageToWidthConverter"/>
            <converters:AlarmTypeToDescriptionConverter x:Key="AlarmTypeToDescriptionConverter"/>
            <converters:AlarmTypeToThresholdLabelConverter x:Key="AlarmTypeToThresholdLabelConverter"/>
            <converters:BoolToDbSourceTextConverter x:Key="BoolToDbSourceTextConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <converters:BooleanToVisibilityInverseConverter x:Key="BoolToVisibilityInverse"/>
            <converters:BooleanToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter"/>
            <converters:IntToVisibilityConverters x:Key="IntToVisibilityConverters"/>
            <converters:ImagePathConverter x:Key="ImagePathConverter"/>
            <converters:ImagePathConverter x:Key="ManualImagePathConverter"/>
            <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
            <converters:MultiPercentageToWidthConverter x:Key="MultiPercentageToWidthConverter"/>
            <converters:DoubleLessThanConverter x:Key="DoubleLessThanConverter"/>

            <!-- Shared defaults keep standalone camera views valid in the XAML designer.
                 MainWindow updates these values at runtime for the active screen size. -->
            <Thickness x:Key="CameraInfoPadding">8,6</Thickness>
            <sys:Double x:Key="CameraInfoFontSize">11</sys:Double>
            <sys:Double x:Key="CameraFeatureLabelFontSize">11</sys:Double>
            <sys:Double x:Key="CameraFeatureIconSize">34</sys:Double>
            <Thickness x:Key="CameraFeatureIconMargin">4</Thickness>

            <Style x:Key="SafeComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="6,3"/>
            </Style>

            <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource SafeComboBoxItemStyle}"/>

           
        </ResourceDictionary>
        <!-- Shadow Effects per Material Design -->
       

    </Application.Resources>
</Application>
