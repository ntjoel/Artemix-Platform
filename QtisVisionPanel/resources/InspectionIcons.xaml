                <GeometryDrawing Geometry="M 158,256 A 46,46 0 1 1 157,256 Z">
                    <GeometryDrawing.Pen><Pen Brush="#E30613" Thickness="22"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 256,256 A 46,46 0 1 1 255,256 Z">
