                </GeometryDrawing>
                <!-- barcode -->
                <GeometryDrawing Brush="#E30613" Geometry="M 140,196 H 156 V 300 H 140 Z"/>
                <GeometryDrawing Brush="#E30613" Geometry="M 172,196 H 196 V 300 H 172 Z"/>
                <GeometryDrawing Brush="#E30613" Geometry="M 212,196 H 224 V 300 H 212 Z"/>
