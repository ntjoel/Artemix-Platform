                <GeometryDrawing Geometry="M 70,130 H 442 V 382 H 70 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="3"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- cordolo di saldatura verticale sul fianco, con irregolarita' -->
                <GeometryDrawing Geometry="M 372,147 V 232 L 340,268 L 372,300 V 365">
                    <GeometryDrawing.Pen><Pen Brush="#E30613" Thickness="30" LineJoin="Miter"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============ BOTTOM SEALING: saldatura di fondo ============ -->
    <DrawingImage x:Key="InspIcon_BottomSealing">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 70,130 H 442 V 382 H 70 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="3"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- cordolo orizzontale in basso con difetto centrale -->
                <GeometryDrawing Geometry="M 96,330 H 216 L 256,296 L 296,330 H 416">
                    <GeometryDrawing.Pen><Pen Brush="#E30613" Thickness="30" LineJoin="Miter"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============ TRAPPED PAPER: carta intrappolata nella saldatura ============ -->
    <DrawingImage x:Key="InspIcon_TrappedPaper">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 70,130 H 442 V 382 H 70 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="3"/></GeometryDrawing.Pen>
