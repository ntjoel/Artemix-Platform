                <!-- quota verticale con frecce -->
                <GeometryDrawing Geometry="M 88,150 V 362">
                    <GeometryDrawing.Pen><Pen Brush="#E30613" Thickness="16"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E30613" Geometry="M 88,120 L 116,164 L 60,164 Z"/>
                <GeometryDrawing Brush="#E30613" Geometry="M 88,392 L 116,348 L 60,348 Z"/>
