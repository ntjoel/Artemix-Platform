<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Icone vettoriali delle ispezioni.

        Perche' vettoriali: i PNG storici sono bitmap a dimensione fissa, sgranano quando la
        card viene ingrandita e alcune ispezioni ne condividevano una sola o usavano un
        generico segno di spunta (Height e SideRollCount usavano COMPLIANT-OK.png). Qui ogni
        ispezione ha il proprio disegno, nitido a qualunque scala.

        Linguaggio grafico: e' quello gia' in uso nei PNG originali e viene mantenuto perche'
        e' chiaro e riconoscibile sulla linea:
          - il PACCO e' un rettangolo grigio (#7F7F7F), tratto spesso, sempre nella stessa
            posizione, cosi' l'occhio riconosce subito il prodotto;
          - l'elemento ROSSO (#E30613) e' cio' che quella specifica ispezione misura.
        Tutte le geometrie usano lo stesso riquadro 512x512 e lo stesso pacco, quindi le icone
        risultano allineate fra loro quando sono affiancate.
    -->

    <!-- Colori condivisi -->
    <SolidColorBrush x:Key="InspIconPackBrush" Color="#7F7F7F"/>
    <SolidColorBrush x:Key="InspIconFeatureBrush" Color="#E30613"/>

    <!-- ============ LOGO: presenza del logo sul pacco ============ -->
    <DrawingImage x:Key="InspIcon_Logo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 70,130 H 442 V 382 H 70 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="3"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- blocco logo pieno, centrato -->
                <GeometryDrawing Brush="#E30613" Geometry="M 196,216 H 316 V 296 H 196 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============ PRINT CENTERING: scostamento del logo dal centro ============ -->
    <DrawingImage x:Key="InspIcon_PrintCentering">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 70,130 H 442 V 382 H 70 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="3"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- assi di centro tratteggiati -->
                <GeometryDrawing Geometry="M 256,148 V 364 M 88,256 H 424">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#7F7F7F" Thickness="8" DashCap="Flat">
                            <Pen.DashStyle><DashStyle Dashes="3,3"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- logo spostato rispetto al centro: e' lo scostamento che si misura -->
                <GeometryDrawing Brush="#E30613" Geometry="M 150,180 H 270 V 250 H 150 Z"/>
                <!-- freccia di scostamento verso il centro -->
                <GeometryDrawing Geometry="M 282,215 H 372">
                    <GeometryDrawing.Pen><Pen Brush="#E30613" Thickness="14"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E30613" Geometry="M 372,195 L 408,215 L 372,235 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============ OPEN FLAPS: alette laterali aperte ============ -->
    <DrawingImage x:Key="InspIcon_OpenFlaps">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 130,130 H 382 V 382 H 130 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="3"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- aletta sinistra aperta -->
                <GeometryDrawing Geometry="M 113,147 L 40,196 V 316 L 113,365">
                    <GeometryDrawing.Pen><Pen Brush="#E30613" Thickness="30" LineJoin="Miter"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- aletta destra aperta -->
                <GeometryDrawing Geometry="M 399,147 L 472,196 V 316 L 399,365">
                    <GeometryDrawing.Pen><Pen Brush="#E30613" Thickness="30" LineJoin="Miter"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============ SURFACE CHECK: difetti/macchie sulla superficie ============ -->
    <DrawingImage x:Key="InspIcon_SurfaceCheck">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 70,130 H 442 V 382 H 70 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="3"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E30613" Geometry="M 150,200 A 26,26 0 1 1 149,200 Z"/>
                <GeometryDrawing Brush="#E30613" Geometry="M 300,180 A 17,17 0 1 1 299,180 Z"/>
                <GeometryDrawing Brush="#E30613" Geometry="M 250,310 A 22,22 0 1 1 249,310 Z"/>
                <GeometryDrawing Brush="#E30613" Geometry="M 360,290 A 14,14 0 1 1 359,290 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============ SHAPE TOP: pacco deformato visto dall'alto ============ -->
    <DrawingImage x:Key="InspIcon_ShapeTop">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- pacco nominale: stesso bordo grigio solido delle altre icone -->
                <GeometryDrawing Geometry="M 70,130 H 442 V 382 H 70 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="3"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- sagoma reale deformata, interna al pacco: e' lo scostamento dal nominale -->
                <GeometryDrawing Geometry="M 120,180 L 392,166 L 402,336 L 112,348 Z">
                    <GeometryDrawing.Pen><Pen Brush="#E30613" Thickness="22" LineJoin="Miter"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============ SHAPE SIDE: profilo laterale deformato ============ -->
    <DrawingImage x:Key="InspIcon_ShapeSide">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- pacco nominale: stesso bordo grigio solido delle altre icone -->
                <GeometryDrawing Geometry="M 70,150 H 442 V 362 H 70 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="3"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- fianco rigonfio interno al pacco: il difetto tipico della vista laterale -->
                <GeometryDrawing Geometry="M 130,190 H 382 C 410,240 410,272 382,322 H 130 C 102,272 102,240 130,190 Z">
                    <GeometryDrawing.Pen><Pen Brush="#E30613" Thickness="22" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

