                <GeometryDrawing Geometry="M 96,320 H 416">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="18"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- lembo di carta che sporge dalla saldatura -->
                <GeometryDrawing Brush="#E30613" Geometry="M 250,320 L 366,246 L 396,290 L 286,320 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============ HEIGHT: altezza del pacco (vista laterale) ============ -->
