            <DrawingGroup>
                <GeometryDrawing Geometry="M 70,130 H 442 V 382 H 70 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7F7F7F" Thickness="34"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- nodi e connessioni: il modello che classifica -->
                <GeometryDrawing Geometry="M 168,200 L 268,256 M 168,312 L 268,256 M 268,256 L 366,208 M 268,256 L 366,304">
                    <GeometryDrawing.Pen><Pen Brush="#E30613" Thickness="12"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E30613" Geometry="M 168,200 A 22,22 0 1 1 167,200 Z"/>
                <GeometryDrawing Brush="#E30613" Geometry="M 168,312 A 22,22 0 1 1 167,312 Z"/>
                <GeometryDrawing Brush="#E30613" Geometry="M 268,256 A 26,26 0 1 1 267,256 Z"/>
                <GeometryDrawing Brush="#E30613" Geometry="M 366,208 A 22,22 0 1 1 365,208 Z"/>
                <GeometryDrawing Brush="#E30613" Geometry="M 366,304 A 22,22 0 1 1 365,304 Z"/>
