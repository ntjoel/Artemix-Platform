<UserControl x:Class="QtisVisionPanel.Views.JobToolEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:converters="clr-namespace:QtisVisionPanel.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900"
             Loaded="JobToolEditorView_Loaded">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1F6FA7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="#1A5D8C">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#195C8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="10,10,10,4"
                Padding="14,10"
                Background="#FFF3CD"
                BorderBrush="#D39E00"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <fa:ImageAwesome Icon="ExclamationTriangle"
                                 Width="18"
                                 Height="18"
                                 Foreground="#856404"
                                 VerticalAlignment="Top"
                                 Margin="0,2,10,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding EditorHoldBannerTitle}"
                               Foreground="#5F4300"
                               FontWeight="Bold"
                               FontSize="14"/>
                    <TextBlock Text="{Binding EditorHoldBannerMessage}"
                               Foreground="#5F4300"
                               FontSize="12"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1"
                    Name="MainTabControl"
                    ItemsSource="{Binding JobPanels}"
                    SelectedItem="{Binding SelectedJobPanel, Mode=TwoWay}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    SelectionChanged="MainTabControl_SelectionChanged"
                    PreviewMouseDown="MainTabControl_PreviewMouseDown"
                    Focusable="True"
                    Background="Transparent">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid Name="Panel" Background="Transparent">
                                    <ContentPresenter x:Name="ContentSite"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      ContentSource="Header"
                                                      Margin="10,2"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Panel" Property="Background" Value="#F0F0F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}"
                               FontWeight="Bold"
                               FontSize="14"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="#D7E2EC"
                                BorderThickness="1"
                                Margin="5"
                                CornerRadius="14"
                                Background="#FBFDFF">
                            <Grid x:Name="ToolEditorContainer">
                                <TextBlock Text="{Binding DataContext.SelectToolPromptText, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#666666"
                                           FontStyle="Italic"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                BorderBrush="#D7E2EC"
                                BorderThickness="0"
                                Margin="5"
                                Background="#F9FBFE"
                                CornerRadius="14"
                                Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding ListTitle}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="5"
                                           Foreground="#1F6FA7"/>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Tools}"
                                         SelectedItem="{Binding SelectedTool, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0"
                                         Background="White">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4"
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="#EEEEEE">
                                                <TextBlock Text="{Binding}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#333333"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#E8F2FA"/>
                                                    <Setter Property="BorderBrush" Value="#1F6FA7"/>
                                                    <Setter Property="BorderThickness" Value="0,0,3,0"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Border Grid.Row="2"
                Background="#FBFDFF"
                BorderBrush="#D7E2EC"
                BorderThickness="0,1,0,0"
                Padding="10">
            <WrapPanel HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Button x:Name="Sub_entry_RefreshToolsButton"
                        Content="Refresh Tools"
                        Command="{Binding RefreshToolsCommand}"
                        Style="{StaticResource ModernButton}"
                        Width="120"
                        Margin="0,0,6,6"/>

                <WrapPanel Visibility="{Binding IsTechnicalUser, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Button x:Name="Sub_entry_RunOnceButton"
                            Content="Run Once"
                            Command="{Binding RunOnceCommand}"
                            Style="{StaticResource ModernButton}"
                            Width="100"
                            Margin="0,0,6,6"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,6,6"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock x:Name="Sub_entry_LivePreviewIntervalLabel"
                                   Text="Interval (ms):"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"
                                   FontSize="11"
                                   Foreground="#6c757d"/>
                        <TextBox Text="{Binding LivePreviewIntervalMs, UpdateSourceTrigger=LostFocus}"
                                 Width="65"
                                 VerticalContentAlignment="Center"
                                 Padding="4,2"/>
                        <TextBlock x:Name="Sub_entry_LivePreviewPulseLabel"
                                   Text="Pulse (ms):"
                                   VerticalAlignment="Center"
                                   Margin="10,0,5,0"
                                   FontSize="11"
                                   Foreground="#6c757d"/>
                        <TextBox Text="{Binding LivePreviewPulseMs, UpdateSourceTrigger=LostFocus}"
                                 Width="55"
                                 VerticalContentAlignment="Center"
                                 Padding="4,2"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,6,6"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="Sub_entry_LivePreviewExposureLabel"
                                   Text="Exposure (us):"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"
                                   FontSize="11"
                                   Foreground="#6c757d"/>
                        <TextBox Text="{Binding LivePreviewExposureUsText, UpdateSourceTrigger=LostFocus}"
                                 Width="78"
                                 VerticalContentAlignment="Center"
                                 Padding="4,2"/>
                        <Button x:Name="Sub_entry_ReadExposureButton"
                                Content="Read"
                                Command="{Binding RefreshLivePreviewExposureCommand}"
                                Style="{StaticResource ModernButton}"
                                Width="74"/>
                        <Button x:Name="Sub_entry_ApplyExposureButton"
                                Content="Apply exposure"
                                Command="{Binding ApplyLivePreviewExposureCommand}"
                                Style="{StaticResource ModernButton}"
                                Width="116"/>
                        <TextBlock Text="{Binding LivePreviewCurrentExposureText}"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#19324B"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="110"/>
                        <TextBlock Text="{Binding LivePreviewExposureStatus}"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"
                                   FontSize="10"
                                   Foreground="#6c757d"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="150"/>
                    </StackPanel>

                    <!-- Sensore 3D (es. testa L38): visibile solo quando il pannello selezionato e' Top3D -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,6,6"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsTop3DPanelSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock x:Name="Sub_entry_Top3DDetectionSensitivityLabel"
                                   Text="Detection sensitivity:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"
                                   FontSize="11"
                                   Foreground="#6c757d"/>
                        <TextBox Text="{Binding Top3DDetectionSensitivityText, UpdateSourceTrigger=LostFocus}"
                                 Width="78"
                                 VerticalContentAlignment="Center"
                                 Padding="4,2"/>
                        <Button x:Name="Sub_entry_ReadDetectionSensitivityButton"
                                Content="Read"
                                Command="{Binding RefreshTop3DDetectionSensitivityCommand}"
                                Style="{StaticResource ModernButton}"
                                Width="74"/>
                        <Button x:Name="Sub_entry_ApplyDetectionSensitivityButton"
                                Content="Apply sensitivity"
                                Command="{Binding ApplyTop3DDetectionSensitivityCommand}"
                                Style="{StaticResource ModernButton}"
                                Width="128"/>
                        <TextBlock Text="{Binding Top3DCurrentDetectionSensitivityText}"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#19324B"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="110"/>
                        <TextBlock Text="{Binding Top3DDetectionSensitivityStatus}"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"
                                   FontSize="10"
                                   Foreground="#6c757d"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="150"/>
                    </StackPanel>

                    <Button x:Name="Sub_entry_LivePreviewButton"
                            Content="Live Preview"
                            Command="{Binding LiveViewCommand}"
                            Width="136"
                            Margin="0,0,6,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="Sub_entry_StopPreviewButton"
                            Content="Stop Preview"
                            Command="{Binding StopLiveDisplayCommand}"
                            Width="136"
                            Margin="0,0,6,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Setter Property="Background" Value="#DC3545"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="Sub_entry_SaveToolButton"
                            Content="Save"
                            Command="{Binding SaveCommand}"
                            Width="100"
                            Margin="0,0,6,6"
                            Background="#28a745"
                            IsEnabled="{Binding CanSave}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource ModernButton}" TargetType="Button">
                                <Setter Property="Background" Value="#28a745"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanSave}" Value="True">
                                        <Setter Property="Background" Value="#28a745"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanSave}" Value="False">
                                        <Setter Property="Background" Value="#CCCCCC"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#218838"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="Sub_entry_QuickBuildButton"
                            Content="QuickBuild"
                            Command="{Binding OpenInQuickBuildCommand}"
                            Width="140"
                            Margin="0,0,0,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveRunning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="1000">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="420"
                    Padding="24"
                    CornerRadius="18"
                    Background="#10253C"
                    BorderBrush="#3B7EB8"
                    BorderThickness="2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56"
                                Height="56"
                                CornerRadius="28"
                                Background="#173B5C">
                            <fa:ImageAwesome Icon="Cogs"
                                             Spin="True"
                                             Foreground="#F4F8FB"
                                             Height="28"
                                             Width="28"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="14,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="Sub_entry_LoadingToolText"
                                       Text="{Binding LoadingStatusTitle}"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding LoadingStatusMessage}"
                                       Foreground="#C8DAEA"
                                       FontSize="14"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding LoadingStatusDetail}"
                               Foreground="#9EB8CF"
                               FontSize="13"
                               Margin="0,18,0,0"
                               TextWrapping="Wrap"/>

                    <ProgressBar Height="16"
                                 Margin="0,18,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding LoadingProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsLoadingIndeterminate, Mode=OneWay}"
                                 Foreground="#38A169"
                                 Background="#24425F"/>

                    <TextBlock Text="{Binding LoadingProgressText}"
                               Foreground="#E9F2F9"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
