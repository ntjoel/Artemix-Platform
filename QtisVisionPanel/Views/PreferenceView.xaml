                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource UserGradient}"
                                CornerRadius="18,18,0,0" Padding="18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" CornerRadius="11" Background="#33FFFFFF" Margin="0,0,10,0">
                                    <fa:FontAwesome Icon="Users" FontSize="18" Foreground="White"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Name="sub_entry_userManger"
                                               FontSize="16" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="Sub_entry_UserCardHint"
                                               Margin="0,2,0,0" FontSize="10" Foreground="#FFF0DE"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card content -->
                        <StackPanel Grid.Row="1" Margin="18,16,18,18">

                            <!-- New user form -->
                            <TextBlock Name="Sub_entry_NewUser"
                                       Style="{StaticResource CardSectionLabelStyle}"/>
                            <TextBlock x:Name="Sub_entry_NewUserHint"
                                       Style="{StaticResource CardHintStyle}"
                                       Margin="0,0,0,14"/>

                            <!-- Username -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesome Grid.Column="0" Icon="User" FontSize="14"
                                               Foreground="#888" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="Sub_entry_Username"
                                               Style="{StaticResource CardHintStyle}" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding NewUsername}"
                                             Style="{StaticResource PreferenceTextBoxStyle}"
                                             Name="Sub_entry_User"/>
                                </StackPanel>
                            </Grid>

                            <!-- Password -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesome Grid.Column="0" Icon="Lock" FontSize="14"
                                               Foreground="#888" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="Sub_entry_Password"
                                               Style="{StaticResource CardHintStyle}" Margin="0,0,0,3"/>
                                    <PasswordBox x:Name="PwdBox1"
                                                 Background="{StaticResource InputBackgroundBrush}"
                                                 BorderBrush="{StaticResource InputBorderBrush}"
                                                 BorderThickness="1" Padding="10,7"
                                                 PasswordChanged="PwdBox1_OnPasswordChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Confirm password -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesome Grid.Column="0" Icon="Lock" FontSize="14"
                                               Foreground="#888" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="Sub_entry_ConfirmPassword"
                                               Style="{StaticResource CardHintStyle}" Margin="0,0,0,3"/>
                                    <PasswordBox x:Name="PwdBox2"
                                                 Background="{StaticResource InputBackgroundBrush}"
                                                 BorderBrush="{StaticResource InputBorderBrush}"
                                                 BorderThickness="1" Padding="10,7"
                                                 PasswordChanged="PwdBox2_OnPasswordChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Role -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesome Grid.Column="0" Icon="IdBadge" FontSize="14"
                                               Foreground="#888" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="Sub_entry_Role"
                                               Style="{StaticResource CardHintStyle}" Margin="0,0,0,3"/>
                                    <ComboBox Name="Sub_entry_role"
                                              ItemsSource="{Binding AvailableRoles}"
                                              SelectedItem="{Binding SelectedRole}"
                                              Background="{StaticResource InputBackgroundBrush}"
                                              BorderBrush="{StaticResource InputBorderBrush}"
                                              BorderThickness="1" Padding="8,6"/>
                                </StackPanel>
                            </Grid>

                            <!-- Add user button -->
                            <Button Command="{Binding AddUserCommand}"
                                    Background="#fc4a1a" Foreground="White"
                                    Padding="14,9" Margin="0,0,0,20"
                                    Style="{StaticResource PrimaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:FontAwesome Icon="UserPlus" FontSize="14" Foreground="White" Margin="0,0,7,0"/>
                                    <TextBlock Name="Sub_entry_addUser" Foreground="White"/>
                                </StackPanel>
                            </Button>

                            <!-- User list -->
                            <TextBlock Name="Sub_Entry_existingUser"
                                       Style="{StaticResource CardSectionLabelStyle}"/>
                            <TextBlock x:Name="Sub_entry_UserListHint"
                                       Style="{StaticResource CardHintStyle}"
                                       Margin="0,0,0,10"/>

                            <Border BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="12" MaxHeight="230" Background="#FBFDFF">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ExistingUsers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#EAF0F6" BorderThickness="0,0,0,1"
                                                        Padding="12,9" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <fa:FontAwesome Grid.Column="0"
                                                                        Icon="{Binding RoleIcon}"
                                                                        FontSize="18"
                                                                        Foreground="{Binding RoleColor}"
                                                                        Margin="0,0,10,0"
                                                                        VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="12"/>
                                                            <Border Background="#F3F7FB" CornerRadius="8"
                                                                    Padding="6,2" Margin="0,3,0,0" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Role}"
                                                                           FontSize="10"
                                                                           Foreground="{Binding RoleColor}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <Ellipse Grid.Column="2" Width="7" Height="7"
                                                                 Fill="{Binding RoleColor}" Margin="0,0,8,0"/>

                                                        <Button Grid.Column="3"
                                                                Command="{Binding DataContext.DeleteUserCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0" Padding="4">
                                                            <fa:FontAwesome Icon="Trash" FontSize="13" Foreground="#F44336"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Button Command="{Binding RefreshUsersCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Right" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <fa:FontAwesome Icon="Refresh" FontSize="12" Margin="0,0,5,0"/>
                                    <TextBlock Name="Sub_netry_updateList" FontSize="12"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- ── Loading overlay ──────────────────────────────────────── -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                CornerRadius="18">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" CornerRadius="16" Padding="24,20"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="50" Height="50"
                                 IsIndeterminate="True"
                                 Style="{StaticResource {x:Type ProgressBar}}"
                                 Margin="0,0,0,14"/>
                    <TextBlock x:Name="Sub_entry_LoadingPreferences"
                               FontSize="15" Foreground="#38516B"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
