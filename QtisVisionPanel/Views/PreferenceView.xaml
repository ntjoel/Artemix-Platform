<UserControl x:Class="QtisVisionPanel.Views.PreferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QtisVisionPanel.Views"
             xmlns:vm="clr-namespace:QtisVisionPanel.ViewModels"
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             xmlns:converters="clr-namespace:QtisVisionPanel.Converters"
             mc:Ignorable="d"
             SizeChanged="PreferenceView_SizeChanged"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="#EEF4FA">

    <UserControl.Resources>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="LanguageGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SystemGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11998e" Offset="0"/>
            <GradientStop Color="#38ef7d" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UserGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#fc4a1a" Offset="0"/>
            <GradientStop Color="#f7b733" Offset="1"/>
        </LinearGradientBrush>

        <!-- Shared brushes -->
        <SolidColorBrush x:Key="CardBorderBrush"   Color="#D6E3EF"/>
        <SolidColorBrush x:Key="PageMutedBrush"    Color="#6B7A90"/>
        <SolidColorBrush x:Key="SectionLabelBrush" Color="#26415C"/>
        <SolidColorBrush x:Key="FieldHintBrush"    Color="#7B8BA0"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F8FBFE"/>
        <SolidColorBrush x:Key="InputBorderBrush"  Color="#C9D8E8"/>
        <SolidColorBrush x:Key="HeaderShellBrush"  Color="#132B43"/>

        <DropShadowEffect x:Key="CardShadow" ShadowDepth="2" BlurRadius="12" Opacity="0.12" Color="#08233D"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DecimalTextBoxConverter x:Key="DecimalTextBoxConverter"/>

        <!-- Card shell -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="CornerRadius"     Value="18"/>
            <Setter Property="Margin"           Value="7"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="BorderBrush"      Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Effect"           Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Text styles -->
        <Style x:Key="CardSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{StaticResource SectionLabelBrush}"/>
            <Setter Property="Margin"       Value="0,0,0,6"/>
        </Style>
        <Style x:Key="CardHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="{StaticResource FieldHintBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ConfigFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#35516D"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Config section card -->
        <Style x:Key="ConfigSectionCardStyle" TargetType="Border">
            <Setter Property="Background"       Value="#F8FBFE"/>
            <Setter Property="BorderBrush"      Value="#D7E4F0"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="12"/>
            <Setter Property="Padding"          Value="16"/>
            <Setter Property="Margin"           Value="0,0,0,12"/>
        </Style>

        <!-- Input -->
        <Style x:Key="PreferenceTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"              Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Padding"                 Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"                Value="12"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="Padding"       Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Page Header ─────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderShellBrush}"
                CornerRadius="18"
                Margin="0,0,0,10"
                Padding="18,14"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="13" Background="#1D476C" Margin="0,0,14,0">
                        <fa:FontAwesome Icon="Cog" FontSize="22" Foreground="White"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="Sub_entry_PreferenceView"
                                   FontSize="21" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="Sub_entry_PreferenceSubtitle"
                                   Margin="0,3,0,0" FontSize="11" Foreground="#BBD0E5"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#1A3A58" CornerRadius="14" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── Cards Area ───────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="PreferenceCardsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" MinWidth="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290" MinWidth="240"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════════════
                     CARD 1 — Language & Localisation  (Col 0)
                ═══════════════════════════════════════════════════ -->
                <Border x:Name="LanguageCard"
                        Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource LanguageGradient}"
                                CornerRadius="18,18,0,0" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="11" Background="#33FFFFFF" Margin="0,0,10,0">
                                        <fa:FontAwesome Icon="Globe" FontSize="18" Foreground="White"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Name="Sub_entry_Language"
                                                   FontSize="16" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="Sub_entry_LanguageCardHint"
                                                   Margin="0,2,0,0" FontSize="10" Foreground="#E3EEFF"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#2DFFFFFF" CornerRadius="12"
                                        Padding="8,5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedLanguage.Code}"
                                               Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card content -->
                        <StackPanel Grid.Row="1" Margin="18,16,18,18">

                            <!-- Language selector label -->
                            <TextBlock Name="Sub_entry_CurrentLanguage"
                                       Style="{StaticResource CardSectionLabelStyle}"/>

                            <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="8" Margin="0,0,0,14"
                                    Background="{StaticResource InputBackgroundBrush}">
                                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          BorderThickness="0" Background="Transparent">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding FullFlagImagePath}"
                                                       Width="22" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Code, StringFormat=' ({0})'}"
                                                           Foreground="#999" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>

                            <!-- Compact flag preview -->
                            <Border BorderBrush="#D9E6F2" BorderThickness="1"
                                    CornerRadius="12" Padding="14,10" Margin="0,0,0,16"
                                    Background="#F7FAFD">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="White" BorderBrush="#E1E9F2" BorderThickness="1"
                                            CornerRadius="8" Padding="6" Margin="0,0,12,0">
                                        <Image Source="{Binding CurrentFlagImage}"
                                               Width="40" Height="30" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedLanguage.DisplayName}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="Sub_entry_LanguagePreviewHint"
                                                   Style="{StaticResource CardHintStyle}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Paths -->
                            <TextBlock x:Name="Sub_entry_ConfigPaths"
                                       Style="{StaticResource CardSectionLabelStyle}"/>

                            <TextBlock Name="Sub_entry_FlagImagesPath"
                                       FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FlagImagesPath}"
                                     Style="{StaticResource PreferenceTextBoxStyle}"
                                     IsReadOnly="True" Margin="0,0,0,10"/>

                            <TextBlock Name="Sub_entry_LanguageFilesPath"
                                       FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding LanguageFilesPath}"
                                     Style="{StaticResource PreferenceTextBoxStyle}"
                                     IsReadOnly="True" Margin="0,0,0,20"/>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding TestPathsCommand}"
                                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                        Margin="0,0,10,0" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:FontAwesome Icon="CheckCircle" FontSize="14" Margin="0,0,5,0"/>
                                        <TextBlock Name="Sub_entry_TestLabel"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SaveLanguageCommand}"
                                        Background="#667eea" Foreground="White"
                                        Padding="18,9"
                                        Style="{StaticResource PrimaryActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:FontAwesome Icon="Save" FontSize="14" Foreground="White" Margin="0,0,5,0"/>
                                        <TextBlock Name="sub_entry_saveLabel" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════
                     CARD 2 — Config.xml Editor  (Col 1)
                ═══════════════════════════════════════════════════ -->
                <Border x:Name="ConfigEditorCard"
                        Grid.Column="1"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding CanManageConfigFile, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource SystemGradient}"
                                CornerRadius="18,18,0,0" Padding="18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" CornerRadius="11" Background="#33FFFFFF" Margin="0,0,10,0">
                                    <fa:FontAwesome Icon="Sliders" FontSize="18" Foreground="White"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Name="Sub_entry_ConfigEditorTitle"
                                               FontSize="16" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="Sub_entry_ConfigEditorCardHint"
                                               Margin="0,2,0,0" FontSize="10" Foreground="#E3FFF7"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card content -->
                        <Grid Grid.Row="1" Margin="18,14,18,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar: path + reload + save -->
                            <Border Grid.Row="0"
                                    Background="#F4F9FE"
                                    BorderBrush="#D7E4F0" BorderThickness="1"
                                    CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Name="Sub_entry_ConfigFilePathLabel"
                                                   Style="{StaticResource CardSectionLabelStyle}"/>
                                        <TextBlock x:Name="Sub_entry_ConfigFilePathHint"
                                                   Style="{StaticResource CardHintStyle}"
                                                   Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding MainConfigFilePath, Mode=OneWay}"
                                                 Style="{StaticResource PreferenceTextBoxStyle}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Command="{Binding ReloadConfigFileCommand}"
                                            Background="#5E7C99" Foreground="White"
                                            Margin="10,0,8,0" Padding="16,11"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PrimaryActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesome Icon="Refresh" FontSize="16" Foreground="White" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="Sub_entry_ReloadConfigButton" Foreground="White"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2"
                                            Command="{Binding SaveConfigFileCommand}"
                                            Background="#11998e" Foreground="White"
                                            Padding="16,11" VerticalAlignment="Center"
                                            Style="{StaticResource PrimaryActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesome Icon="Save" FontSize="16" Foreground="White" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="Sub_entry_SaveConfigButton" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Config sections in 2 columns -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left column -->
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">

                                        <Border Style="{StaticResource ConfigSectionCardStyle}"
                                                BorderBrush="#667eea" BorderThickness="3,0,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="Sub_entry_ConfigSectionPaths"
                                                           Style="{StaticResource CardSectionLabelStyle}"/>
                                                <TextBlock x:Name="Sub_entry_ConfigSectionPathsHint"
                                                           Style="{StaticResource CardHintStyle}"
                                                           Margin="0,0,0,12"/>
                                                <TextBlock x:Name="Sub_entry_ConfigMachineTypeLabel" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.MachineType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="Sub_entry_ConfigRecipeFolderLabel" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.Recipe_Folder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="Sub_entry_ConfigImageDirLabel" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.ImageDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="Sub_entry_ConfigBackupRecipeLabel" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.BackupRecipe, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="Sub_entry_ConfigDashboardLabel" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.Dashboard, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock Text="Company" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.Compagny, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock Text="Data hostname" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.DataHostnames, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock Text="Camera count" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.NumCamera, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock Text="Days to clean data" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.DayToCleanData, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ConfigSectionCardStyle}"
                                                BorderBrush="#764ba2" BorderThickness="3,0,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="Sub_entry_ConfigSectionCameras"
                                                           Style="{StaticResource CardSectionLabelStyle}"/>
                                                <TextBlock x:Name="Sub_entry_ConfigSectionCamerasHint"
                                                           Style="{StaticResource CardHintStyle}"
                                                           Margin="0,0,0,12"/>
                                                <TextBlock x:Name="Sub_entry_ConfigTopCameraSerialLabel" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.TopCameraSerial, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="Sub_entry_ConfigSideCameraSerialLabel" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.SideCameraSerial, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="Sub_entry_ConfigFrontCameraSerialLabel" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.FrontCameraSerial, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="Sub_entry_ConfigRearCameraSerialLabel" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.RearCameraSerial, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="Sub_entry_ConfigBottomCameraSerialLabel" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.BottomCameraSerial, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- VisionPro outputs -->
                                        <Border Style="{StaticResource ConfigSectionCardStyle}"
                                                BorderBrush="#9C27B0" BorderThickness="3,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="VisionPro outputs" Style="{StaticResource CardSectionLabelStyle}"/>
                                                <TextBlock Text="Channel names written by the inspection engine"
                                                           Style="{StaticResource CardHintStyle}" Margin="0,0,0,12"/>
                                                <TextBlock Text="Traceability presence output" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.FrontTraceabilityPresenceOutput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock Text="Traceability code output" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.FrontTraceabilityCodeOutput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock Text="3D height output" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.ThreeDHeightOutput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock Text="3D width output" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.ThreeDWidthOutput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock Text="3D length output" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.ThreeDLengthOutput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>

                                                <Border BorderBrush="#D7E2EC"
                                                        BorderThickness="0,1,0,0"
                                                        Margin="0,4,0,12"
                                                        Padding="0,12,0,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="Sub_entry_ConfigTop3DMeasurementOffsets"
                                                                   Style="{StaticResource CardSectionLabelStyle}"/>
                                                        <TextBlock x:Name="Sub_entry_ConfigTop3DMeasurementOffsetsHint"
                                                                   Style="{StaticResource CardHintStyle}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,10"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                                <TextBlock x:Name="Sub_entry_ConfigTop3DHeightOffsetLabel"
                                                                           Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Grid.Column="0"
                                                                             Text="{Binding RuntimeConfiguration.Top3DHeightMeasurementOffsetMm, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalTextBoxConverter}}"
                                                                             Style="{StaticResource PreferenceTextBoxStyle}"/>
                                                                    <TextBlock Grid.Column="1" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Margin="3,0">
                                                                <TextBlock x:Name="Sub_entry_ConfigTop3DWidthOffsetLabel"
                                                                           Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Grid.Column="0"
                                                                             Text="{Binding RuntimeConfiguration.Top3DWidthMeasurementOffsetMm, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalTextBoxConverter}}"
                                                                             Style="{StaticResource PreferenceTextBoxStyle}"/>
                                                                    <TextBlock Grid.Column="1" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                                                <TextBlock x:Name="Sub_entry_ConfigTop3DLengthOffsetLabel"
                                                                           Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Grid.Column="0"
                                                                             Text="{Binding RuntimeConfiguration.Top3DLengthMeasurementOffsetMm, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalTextBoxConverter}}"
                                                                             Style="{StaticResource PreferenceTextBoxStyle}"/>
                                                                    <TextBlock Grid.Column="1" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock x:Name="Sub_entry_ConfigTop3DMeasurementOffsetsFormula"
                                                                   Style="{StaticResource CardHintStyle}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="Top3D rerender result output" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.Top3DRerenderResultOutput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <TextBlock Text="Top3D point cloud output" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <TextBox Text="{Binding RuntimeConfiguration.Top3DPointCloudOutput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PreferenceTextBoxStyle}" Margin="0,0,0,10"/>
                                                <CheckBox Content="Save Top3D rendered 2D image"
                                                          IsChecked="{Binding RuntimeConfiguration.SaveTop3DRendered2DImage}"
                                                          Margin="0,0,0,8"/>
                                                <CheckBox Content="Save Top3D range image"
                                                          IsChecked="{Binding RuntimeConfiguration.SaveTop3DRangeImage}"
                                                          Margin="0,0,0,8"/>
                                                <CheckBox Content="Save Top3D point cloud CSV"
