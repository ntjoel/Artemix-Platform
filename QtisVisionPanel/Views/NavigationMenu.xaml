<UserControl x:Class="QtisVisionPanel.Views.NavigationMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uc="clr-namespace:QtisVisionPanel.Views.UserControls"
             xmlns:converters="clr-namespace:QtisVisionPanel.Converters"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d"
             MinHeight="600"
             MinWidth="{DynamicResource NavigationMinWidth}">
    <UserControl.Resources>
        <converters:IntToVisibilityConverters x:Key="IntToVisibilityConverters"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F6FAFE"/>
        <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#F6FAFE"/>
        <SolidColorBrush x:Key="PanelSurfaceMutedBrush" Color="#F6FAFE"/>
        <SolidColorBrush x:Key="PanelStrokeBrush" Color="Orange"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#132A42"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#132A42"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3AA0FF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B4C78"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#2C79B8"/>
        <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#2C79B8"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="Orange"/>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{DynamicResource NavigationSectionHeaderFontSize}"/>
            <Setter Property="Margin" Value="{DynamicResource NavigationSectionHeaderMargin}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MenuHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource NavigationMenuHeaderFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SubMenuHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="{DynamicResource NavigationSubMenuHeaderFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MenuExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource PanelSurfaceMutedBrush}"
                                BorderBrush="{StaticResource PanelStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="6">
                            <StackPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalContentAlignment="Stretch">
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0"
                                                          ContentSource="Header"
                                                          RecognizesAccessKey="True"/>
                                        <Path Grid.Column="2"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              Fill="{StaticResource SecondaryTextBrush}"
                                              Data="M 0 0 L 8 0 L 4 4 Z"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  ContentSource="Content"
                                                  Margin="8,4,8,8"
                                                  Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="HeaderSite" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasChildren}" Value="True"/>
                        <Condition Binding="{Binding IsSectionHeader}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="{DynamicResource NavigationButtonPadding}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasChildren}" Value="False"/>
                        <Condition Binding="{Binding IsSectionHeader}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuItemTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubMenuHeaderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuItemIconStyle" TargetType="fa:ImageAwesome">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExternalActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="{DynamicResource NavigationButtonPadding}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="{DynamicResource NavigationHeaderMargin}"
                Padding="{DynamicResource NavigationHeaderPadding}"
                CornerRadius="14"
                Background="{StaticResource PanelSurfaceBrush}"
                BorderBrush="{StaticResource PanelStrokeBrush}"
                BorderThickness="1">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <Image Source="/resources/logo_pulsar.png"
                           Height="{DynamicResource NavigationLogoHeight}"
                           x:Name="PulsarInfo"
                           DockPanel.Dock="Left"
                           Cursor="Hand"
                           ToolTip="Software version"
                           MouseLeftButtonUp="PulsarInfo_MouseLeftButtonUp"/>
                </DockPanel>

                <TextBlock x:Name="Sub_entry_CompanyPanelTitle"
                           Text="Industrial Vision Control"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="{DynamicResource NavigationTitleFontSize}"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="Sub_entry_NavigationSummary"
                           Text="Navigazione rapida delle aree macchina"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="{DynamicResource NavigationSummaryFontSize}"
                           Margin="0,2,0,8"/>

                <Border Background="#F6FAFE"
                        CornerRadius="10"
                        BorderBrush="{StaticResource PanelStrokeBrush}"
                        BorderThickness="1"
                        Padding="8,6">
                    <TextBlock Text="08:38:40"
                               x:Name="lbdate"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource NavigationDateFontSize}"/>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{DynamicResource NavigationMenuStackMargin}">
                <ItemsControl ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Header}"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           Visibility="{Binding IsSectionHeader, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <Border Height="1"
                                        Background="{StaticResource SeparatorBrush}"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding IsSectionHeader, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          Style="{StaticResource MenuExpanderStyle}"
                                          Expanded="Expander_Expanded"
                                          Collapsed="Expander_Collapsed">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <fa:ImageAwesome Icon="{Binding Icon}"
                                                             Width="16"
                                                             Height="16"
                                                             Foreground="{StaticResource PrimaryTextBrush}"
                                                             Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Header}"
                                                       Style="{StaticResource MenuHeaderStyle}"/>
                                        </StackPanel>
                                    </Expander.Header>

                                    <ItemsControl ItemsSource="{Binding Children}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding Command}"
                                                        CommandParameter="{Binding CommandParameter}"
                                                        Style="{StaticResource MenuItemButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <fa:ImageAwesome Icon="{Binding Icon}"
                                                                         Style="{StaticResource MenuItemIconStyle}"/>
                                                        <TextBlock Text="{Binding Header}"
                                                                   Style="{StaticResource MenuItemTextStyle}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <Button Command="{Binding Command}"
                                        CommandParameter="{Binding CommandParameter}"
                                        Style="{StaticResource MenuItemButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <fa:ImageAwesome Icon="{Binding Icon}"
                                                         Style="{StaticResource MenuItemIconStyle}"/>
                                        <TextBlock Text="{Binding Header}"
                                                   Style="{StaticResource MenuItemTextStyle}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="{DynamicResource NavigationFooterMargin}"
                Padding="{DynamicResource NavigationFooterPadding}"
                Background="{StaticResource PanelSurfaceBrush}"
                BorderBrush="{StaticResource PanelStrokeBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <uc:ControlButtons DataContext="{Binding ControlButtonsVM}"/>
        </Border>
    </Grid>
</UserControl>
