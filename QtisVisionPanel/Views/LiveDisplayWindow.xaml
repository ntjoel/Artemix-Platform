<Window x:Class="QtisVisionPanel.Views.LiveDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:cog="clr-namespace:Cognex.VisionPro;assembly=Cognex.VisionPro.Controls"
        mc:Ignorable="d"
        Title="Live Preview"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0E1726">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="14,12"
                CornerRadius="14"
                Background="#152238"
                BorderBrush="#243A5A"
                BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Anteprima live camera per setup e diagnostica"
                               Foreground="#9FB2C8"
                               FontSize="12"/>
                </StackPanel>
                <Border DockPanel.Dock="Right"
                        Background="#19324D"
                        CornerRadius="999"
                        Padding="12,6"
                        Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#31C48D" Margin="0,0,8,0"/>
                        <TextBlock Text="LIVE"
                                   Foreground="#DCEAF7"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                CornerRadius="18"
                BorderBrush="#243A5A"
                BorderThickness="1"
                Background="#09111F"
                Padding="10">
            <wf:WindowsFormsHost>
                <cog:CogRecordDisplay x:Name="LiveCogDisplay"/>
            </wf:WindowsFormsHost>
        </Border>
    </Grid>
</Window>
