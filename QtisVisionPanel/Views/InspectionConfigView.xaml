<UserControl x:Class="QtisVisionPanel.Views.InspectionConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:converters="clr-namespace:QtisVisionPanel.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <UserControl.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#D6E3EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="FeatureCardStyle" TargetType="Border">
            <Setter Property="Width" Value="295"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#D6E3EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="BorderBrush" Value="#46B35B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Background" Value="#FBFDFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#F5F9FD"/>
            <Setter Property="Foreground" Value="#12304D"/>
            <Setter Property="BorderBrush" Value="#D2DEEA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="InspectionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="62"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="16" Background="#CCD7E1">
                            <Grid><Ellipse x:Name="Thumb" Width="28" Height="28" Fill="White" HorizontalAlignment="Left" Margin="2"/></Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4DB167"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F8FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="16,16,16,12" Padding="22,18" Background="#0E2237" CornerRadius="20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="Sub_entry_Inspection_header" Text="Inspection Configuration" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="Sub_entry_Inspection_inf" Text="Configure active cameras and inspections for the current recipe" Margin="0,6,0,0" Foreground="#9DB4C8" FontSize="13"/>
                    <TextBlock Text="{Binding ActiveRecipeDisplay}" Margin="0,4,0,0" Foreground="#D5E4F1" FontSize="12"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#173450" CornerRadius="16" Padding="14,12" MinWidth="230">
                    <StackPanel>
                        <TextBlock x:Name="Sub_entry_Inspection_machineTypeLabel" Text="Machine type" Foreground="#9DB4C8" FontSize="11"/>
                        <ComboBox Margin="0,8,0,0" Height="34" ItemsSource="{Binding MachineTypes}" SelectedItem="{Binding MachineType, Mode=TwoWay}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,0,16,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="Sub_entry_Inspection_enabledSummary" Text="Enabled" Foreground="#688098" FontSize="11"/>
                        <TextBlock Text="{Binding EnabledFeatureCount}" Foreground="#12304D" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="Sub_entry_Inspection_disabledSummary" Text="Disabled" Foreground="#688098" FontSize="11"/>
                        <TextBlock Text="{Binding DisabledFeatureCount}" Foreground="#12304D" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="Sub_entry_Inspection_totalSummary" Text="Total" Foreground="#688098" FontSize="11"/>
                        <TextBlock Text="{Binding TotalFeatureCount}" Foreground="#12304D" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="White" BorderBrush="#D6E3EF" BorderThickness="1" CornerRadius="20" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>

                    <!-- Matrice vista x ispezione: quali controlli verifica ciascuna camera.
                         Senza questa configurazione il runtime usa la tabella di applicabilita'
                         storica, quindi la sezione e' additiva e non cambia il comportamento
                         finche' l'operatore non salva. -->
                    <Border x:Name="Sub_entry_Inspection_matrixSection"
                            Background="#F7FAFD" BorderBrush="#D6E3EF" BorderThickness="1"
                            CornerRadius="16" Padding="16" Margin="0,0,0,18"
                            Visibility="{Binding HasViewMatrix, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock x:Name="Sub_entry_Inspection_matrixTitle"
                                       Text="Inspections per camera view"
                                       FontSize="18" FontWeight="SemiBold" Foreground="#102B46"/>
                             <TextBlock x:Name="Sub_entry_Inspection_matrixHint"
                                       Text="Select which cameras this recipe uses, then enable only the inspections produced by each VisionPro view. Machine I/O mapping remains global."
                                       Margin="0,6,0,14" Foreground="#70869B" FontSize="12" TextWrapping="Wrap"/>

                            <ItemsControl ItemsSource="{Binding ViewMatrix}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E4EBF2" BorderThickness="1"
                                                CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="260"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="14" FontWeight="SemiBold" Foreground="#17324D"/>
                                                        <TextBlock Text="{Binding DataContext.CameraUsageLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   FontSize="10" Foreground="#70869B" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1"
                                                              Height="30"
                                                              ItemsSource="{Binding DataContext.CameraModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="DisplayName"
                                                              SelectedValuePath="Value"
                                                              SelectedValue="{Binding CameraMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Inspections}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                             <CheckBox Content="{Binding DisplayName}"
                                                                       IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                       IsEnabled="{Binding DataContext.IsCameraEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      Margin="0,0,18,8"
                                                                      MinWidth="150"
                                                                      Foreground="#102B46"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Tassonomia Classify (ViDi EL) di questa vista.
                                                     Un modello Edge Learning e' addestrato per camera,
                                                     quindi le classi di OK cambiano da vista a vista.
                                                     Campo vuoto = nessuna policy, vale il comportamento
                                                     storico con le etichette standard. -->
                                                <TextBlock Text="{Binding DataContext.AcceptedClassesLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Foreground="#70869B" FontSize="11"
                                                           Margin="0,6,0,2"/>
                                                <TextBox Text="{Binding AcceptedClasses, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="26"
                                                         IsEnabled="{Binding IsCameraEnabled}"
                                                         ToolTip="{Binding DataContext.AcceptedClassesToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                                <!-- Soglia di confidenza della vista. Sotto questo
                                                     punteggio la classe non e' considerata
                                                     riconosciuta: il pezzo diventa non classificato
                                                     e va a scarto, perche' puo' essere un prodotto
                                                     diverso o un caso mai visto in addestramento.
                                                     0 = soglia disattivata. -->
                                                <TextBlock Text="{Binding DataContext.MinimumScoreLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Foreground="#70869B" FontSize="11"
                                                           Margin="0,6,0,2"/>
                                                <TextBox Text="{Binding MinimumClassificationScore, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"
                                                         Height="26"
                                                         IsEnabled="{Binding IsCameraEnabled}"
                                                         ToolTip="{Binding DataContext.MinimumScoreToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FeatureCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="46" Height="46" CornerRadius="14" Background="#EFF5FB">
                                                <Image Source="{Binding Icon, Converter={StaticResource ImagePathConverter}}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" Foreground="#102B46"/>
                                                <TextBlock Text="{Binding LocalizedDescription}" Margin="0,6,0,0" Foreground="#70869B" FontSize="12" TextWrapping="Wrap" MaxHeight="34"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Padding="10,4" CornerRadius="999">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FEEFEF"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Background" Value="#E9F7EF"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BooleanToStatusConverter}}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#C84D4D"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Foreground" Value="#287C46"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <Border Grid.Row="1" Margin="0,14,0,14" Padding="12" Background="#F6FAFE" CornerRadius="14" BorderBrush="#E2ECF4" BorderThickness="1">
                                            <TextBlock Text="{Binding LocalizedDescription}" Foreground="#5D7286" FontSize="12" TextWrapping="Wrap" MaxHeight="54"/>
                                        </Border>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BooleanToStatusConverter}}" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#C84D4D"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Foreground" Value="#2B8C4A"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource InspectionToggleStyle}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                  </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="16,0,16,16" Background="White" BorderBrush="#D6E3EF" BorderThickness="1" CornerRadius="18" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="12,10" CornerRadius="12" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#EAF7EE"/>
                                <Setter Property="BorderBrush" Value="#B8E0C2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                        <Setter Property="Background" Value="#FFF4E7"/>
                                        <Setter Property="BorderBrush" Value="#FFD39A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="#12304D"/>
                    </Border>
                    <TextBlock Text="{Binding IsBusy, Converter={StaticResource BusyStatusConverter}}" Margin="12,0,0,0" Foreground="#688098" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="Sub_entry_Inspection_reloadButton" Content="Ricarica" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="Sub_entry_Inspection_resetButton" Content="Reset Default" Command="{Binding ResetToDefaultCommand}" Background="#F59E0B" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="Sub_entry_Inspection_saveButton" Content="Salva" Command="{Binding SaveCommand}" Background="#43B05C" Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80091829" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="74" Height="74" CornerRadius="37" Background="#0E2237">
                    <fa:ImageAwesome Icon="Refresh" Spin="True" Foreground="White" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="Sub_entry_Inspection_loadingText" Text="Caricamento..." Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
