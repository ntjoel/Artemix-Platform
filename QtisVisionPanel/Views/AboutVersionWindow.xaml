<Window x:Class="QtisVisionPanel.Views.AboutVersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Software Version"
        Width="860"
        Height="640"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#E9F0F6"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0F2237"/>
        <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#F7FAFD"/>
        <SolidColorBrush x:Key="PanelStrokeBrush" Color="#D3E0EC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2C79B8"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF3FB"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#10263C"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6E8297"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="#203B56"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="84"
                        Height="84"
                        Background="White"
                        CornerRadius="14"
                        Padding="10"
                        VerticalAlignment="Center">
                    <Image Source="/resources/logo_pulsar.png" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="Sub_entry_AboutWindowTitle"
                               Text="Software Version"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="Sub_entry_AboutWindowSubtitle"
                               Text="Unified industrial baseline, runtime modules and current configuration contract"
                               Foreground="#B5C8DA"
                               FontSize="13"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <Border Margin="0,12,0,0"
                            Background="#183552"
                            CornerRadius="999"
                            Padding="10,4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding DisplayVersionBadge}"
                                   Foreground="#D8EBFA"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <TextBlock x:Name="Sub_entry_AboutCompanyLabel"
                               Text="Company"
                               Foreground="#8FAAC2"
                               FontSize="11"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CompanyName}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="14"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="Sub_entry_AboutMachineLabel"
                               Text="Machine"
                               Foreground="#8FAAC2"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding MachineTypeDisplay}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="14"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="Sub_entry_AboutSoftwareSectionTitle" Text="Software Identity" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="Sub_entry_AboutSoftwareSectionHint" Text="Official versioning and product metadata exposed by the current build." Style="{StaticResource SectionHintStyle}"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Version" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SoftwareVersion}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Assembly" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AssemblyVersion}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="Sub_entry_AboutReleaseDateLabel" Grid.Row="2" Text="Release date" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReleaseDateDisplay}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="Sub_entry_AboutLastUpdateLabel" Grid.Row="3" Text="Last update" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastUpdateDisplay}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="4" Text="Product" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProductName}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="5" Text="Runtime" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RuntimeFramework}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,10,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="Sub_entry_AboutRuntimeSectionTitle" Text="Runtime Contract" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="Sub_entry_AboutRuntimeSectionHint" Text="Config-driven runtime paths and live machine targets currently in use." Style="{StaticResource SectionHintStyle}"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Config.xml" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConfigFilePath}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Database" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseTarget}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Recipe folder" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RecipeFolder}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="3" Text="Image root" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ImageRoot}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="4" Text="Active recipe" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActiveRecipe}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="Sub_entry_AboutModulesSectionTitle" Text="Integrated Modules" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="Sub_entry_AboutModulesSectionHint" Text="Versions resolved from the assemblies currently loaded by the application." Style="{StaticResource SectionHintStyle}"/>
                            <ListView ItemsSource="{Binding Modules}" Margin="0,16,0,0" BorderThickness="0" Background="Transparent">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#D3E2F1" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Margin="12,0,0,0" Background="White" BorderBrush="#D2DFEC" BorderThickness="1" CornerRadius="999" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Version}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="Sub_entry_AboutNotesSectionTitle" Text="Version Archive" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="Sub_entry_AboutNotesSectionHint" Text="The project now tracks official versions, functional changes, configuration additions and database notes in a dedicated archive." Style="{StaticResource SectionHintStyle}"/>
                            <Border Margin="0,16,0,0" Background="#F2F7FB" BorderBrush="#D3E0EC" BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock x:Name="Sub_entry_AboutArchivePathLabel" Text="Archive file" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding VersionArchivePath}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,14,0,0">
            <Button x:Name="Sub_entry_OpenVersionArchiveButton" Content="Open version archive" Click="OpenVersionArchiveButton_Click" Background="{StaticResource AccentBrush}" Style="{StaticResource ActionButtonStyle}" DockPanel.Dock="Left"/>
            <Button x:Name="Sub_entry_CloseAboutButton" Content="Close" Click="CloseAboutButton_Click" Background="#647789" Style="{StaticResource ActionButtonStyle}" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
