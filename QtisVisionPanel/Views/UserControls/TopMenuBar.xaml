<UserControl x:Class="QtisVisionPanel.Views.UserControls.TopMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:converters="clr-namespace:QtisVisionPanel.Converters"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="800">
    <UserControl.Resources>
        <converters:MachinestatusToIconConverter x:Key="StatusToIconConverter"/>
        <converters:MachinestatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:AlarmLevelToColorConverter x:Key="AlarmToColorConverter"/>
        <converters:AlarmLevelToIconConverter x:Key="AlarmToIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BooleanToVisibilityInverseConverter x:Key="BoolToVisibilityInverse"/>
        <converters:MachineStatusToSpinBoolConverter x:Key="MachineStatusToSpinBoolConverter"/>

        <Storyboard x:Key="Spin360Storyboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0"
                             To="360"
                             Duration="0:0:1"/>
        </Storyboard>

        <Style x:Key="RotatingIconStyle" TargetType="{x:Type fa:ImageAwesome}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentMachineStatus, Converter={StaticResource MachineStatusToSpinBoolConverter}}"
                             Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinBegin" Storyboard="{StaticResource Spin360Storyboard}"/>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinBegin"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="{DynamicResource TopBarMetricCardPadding}"/>
            <Setter Property="Margin" Value="{DynamicResource TopBarMetricCardMargin}"/>
            <Setter Property="Background" Value="#F6FAFE"/>
            <Setter Property="BorderBrush" Value="DarkOrange"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5E7288"/>
            <Setter Property="FontSize" Value="{DynamicResource TopBarMetricLabelFontSize}"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#12273D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource TopBarMetricValueFontSize}"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#F7FAFD"
            BorderBrush="#D7E3EE"
            BorderThickness="1"
            CornerRadius="14"
            Padding="{DynamicResource TopBarPadding}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                   
                    CornerRadius="12" Style="{StaticResource MetricCardStyle}"
                    Padding="{DynamicResource TopBarStatusPadding}"
                    MinWidth="{DynamicResource TopBarStatusMinWidth}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fa:ImageAwesome x:Name="StatusIcon"
                                         Grid.Column="0"
                                         Icon="{Binding CurrentMachineStatus, Converter={StaticResource StatusToIconConverter}}"
                                         Foreground="{Binding CurrentMachineStatus, Converter={StaticResource StatusToColorConverter}}"
                                         Width="22"
                                         Height="22"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource RotatingIconStyle}"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="Sub_entry_MachineStatusLabel"
                                       Text="Machine Status"
                                       Style="{StaticResource MetricLabelStyle}"
                                       
                                       FontSize="{DynamicResource TopBarStatusLabelFontSize}"/>
                            <TextBlock Text="{Binding MachineStatusText}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       FontSize="{DynamicResource TopBarStatusValueFontSize}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Command="{Binding ShowSystemDiagnosticsCommand}"
                                IsEnabled="{Binding CanOpenSystemDiagnostics}"
                                Background="{Binding DiagnosticsStatusBrush}"
                                ToolTip="{Binding DiagnosticsTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Desktop"
                                                 Foreground="White"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,6,0"/>
                                <Border Background="#D64545"
                                        CornerRadius="999"
                                        MinWidth="22"
                                        Height="22"
                                        Padding="6,0"
                                        Margin="0,0,4,0"
                                        Visibility="{Binding HasDiagnosticsAlerts, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding DiagnosticsAlertCount}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- Fase 9: preallarmi AI (SPC/salute PC) non ancora visti - distinto dal badge
                                     rosso sopra (solo errori critici di sistema). Stesso bottone/destinazione:
                                     apre PC Diagnostics, dove il pannello "Controlli AI" azzera questo badge. -->
                                <Border Background="#D68A2C"
                                        CornerRadius="999"
                                        MinWidth="22"
                                        Height="22"
                                        Padding="6,0"
                                        ToolTip="{Binding AiAdvisoryTooltip}"
                                        Visibility="{Binding HasAiAdvisories, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding AiAdvisoryBadgeCount}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Command="{Binding ShowAlarmDetailsCommand}"
                                Background="#D6E3EF"
                                ToolTip="{Binding LastAlarmMessage}"
                                Style="{StaticResource ActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="{Binding CurrentAlarmLevel, Converter={StaticResource AlarmToIconConverter}}"
                                                 Foreground="{Binding CurrentAlarmLevel, Converter={StaticResource AlarmToColorConverter}}"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,6,0"/>
                                <Border Background="#D64545"
                                        CornerRadius="999"
                                        MinWidth="22"
                                        Height="22"
                                        Padding="6,0"
                                        Visibility="{Binding HasActiveAlarms, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ActiveAlarmCount}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,8,0,0"
                            Padding="8,5"
                            CornerRadius="10"
                            Background="#4D3312"
                            BorderBrush="{Binding RuntimeHoldBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasRuntimeHold, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding RuntimeHoldTooltip}" >
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="PauseCircle"
                                             Foreground="{Binding RuntimeHoldBrush}"
                                             Width="14"
                                             Height="14"
                                             Margin="0,0,6,0"/>
                            <TextBlock x:Name="Sub_entry_RuntimeHoldLabel"
                                       Text="Runtime hold"
                                       Foreground="#E7C99A"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding RuntimeHoldDisplayText}"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Cogs"
                                             Foreground="#2C79B8"
                                             Width="14"
                                             Height="14"
                                             Margin="0,0,6,0"/>
                            <TextBlock Text="Ricetta attiva"
                                       Style="{StaticResource MetricLabelStyle}"
                                       x:Name="Sub_entry_Recipe"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentRecipeName}"
                                   Foreground="#13293F"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource TopBarMetricValueFontSize}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentRecipePath}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Dashboard"
                                             Foreground="#2E9E75"
                                             Width="14"
                                             Height="14"
                                             Margin="0,0,6,0"/>
                            <TextBlock Text="Velocita"
                                       Style="{StaticResource MetricLabelStyle}"
                                       x:Name="Sub_entry_speed"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TransportSpeed}"
                                   Style="{StaticResource MetricValueStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="LineChart"
                                                 Foreground="#2E9E75"
                                                 Width="14"
                                                 Height="14"
                                                 Margin="0,0,6,0"/>
                                <TextBlock x:Name="Sub_entry_QualityIndexTopBar"
                                           Text="Quality index"
                                           Style="{StaticResource MetricLabelStyle}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding QualityIndexText}"
                                       Foreground="#1F7F5F"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource TopBarMetricValueFontSize}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding QualityIndexDetailText}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Foreground="#7B8EA3"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="1"
                                Margin="0,2"
                                Background="#D6E3EF"/>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="BarChart"
                                                 Foreground="#D98E2F"
                                                 Width="14"
                                                 Height="14"
                                                 Margin="0,0,6,0"/>
                                <TextBlock Text="Produzione"
                                           Style="{StaticResource MetricLabelStyle}"
                                           x:Name="Sub_entry_Production"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ProductionCounter}"
                                       Style="{StaticResource MetricValueStyle}"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="Sub_entry_GoodTotalLabelTopBar"
                                       Text="Good/Total"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Foreground="#7B8EA3"
                                       Margin="0,2,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="Sub_entry_SessionLabel"
                                   Text="Sessione"
                                   Style="{StaticResource MetricLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentUserRole}"
                                   Style="{StaticResource MetricValueStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="3"
                    
                    Style="{StaticResource MetricCardStyle}"
                    CornerRadius="12"
                    Padding="10,8"
                    MinWidth="210">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">
                        <fa:ImageAwesome Icon="User"
                                         Foreground="#D4E2EF"
                                        Width="14"
                                        Height="14"
                                         Margin="0,0,6,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUser}"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentUserRole}"
                                       Foreground="#8FB0CA"
                                       FontSize="10"/>
                        </StackPanel>
                        <Button Content="Logout"
                                x:Name="Sub_entry_logout"
                                Command="{Binding LogoutCommand}"
                                Background="#C64646"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityInverse}}">
                        <fa:ImageAwesome Icon="User"
                                         Foreground="#8EA8C0"
                                         Width="14"
                                         Height="14"
                                         Margin="0,0,6,0"/>
                        <StackPanel>
                            <TextBlock x:Name="Sub_entry_GuestLabel"
                                       Text="Guest"
                                        Style="{StaticResource MetricLabelStyle}"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="Sub_entry_LimitedAccessLabel"
                                       Text="Accesso limitato"
                                       Style="{StaticResource MetricLabelStyle}"
                                       FontSize="10"/>
                        </StackPanel>
                        <Button Content="Login"
                                x:Name="Sub_entry_login"
                                Command="{Binding ShowLoginCommand}"
                                Background="#2C79B8"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
