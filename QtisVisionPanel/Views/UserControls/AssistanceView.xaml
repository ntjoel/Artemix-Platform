<UserControl x:Class="QtisVisionPanel.Views.UserControls.AssistanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="#F4F8FC">
    <UserControl.Resources>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2C79B8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C79B8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#142B46"
                CornerRadius="22"
                Padding="20,16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="Sub_entry_AssistanceTitleText"
                               Text="Assistance"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding SupportSummary}"
                               Foreground="#BFD3EA"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="Sub_entry_AssistanceOpenManualButton"
                            Content="Apri manuale"
                            Command="{Binding OpenManualCommand}"
                            Style="{StaticResource ActionButtonStyle}"/>
                    <Button x:Name="Sub_entry_AssistanceOpenPortalButton"
                            Content="Portale azienda"
                            Command="{Binding OpenCompanyPortalCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#173755"
                            BorderBrush="#173755"
                            Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PanelCardStyle}"
                Padding="18"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding CompanyName}"
                               Foreground="#102A43"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding CompanyArea}"
                               Foreground="#5F738A"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Sub_entry_AssistanceProductionLabel" Text="Produzione" Foreground="#5F738A" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ProductionSupport}" Foreground="#102A43" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="Sub_entry_AssistanceTechnicalLabel" Text="Supporto tecnico" Foreground="#5F738A" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TechnicalSupport}" Foreground="#102A43" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock x:Name="Sub_entry_AssistanceITLabel" Text="IT / Ricambi" Foreground="#5F738A" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ITSupport}" Foreground="#102A43" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SparePartsSupport}" Foreground="#5F738A" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Name="Sub_entry_AssistanceChecklistTitle"
                           Text="Checklist prima di richiedere supporto"
                           Foreground="#102A43"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12"/>

                <Border Grid.Row="1"
                        Background="#F8FBFF"
                        BorderBrush="#D6E2F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ServiceChecklist, Mode=OneWay}"
                                   Foreground="#243B53"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
