<UserControl x:Class="QtisVisionPanel.Views.UserControls.ControlButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QtisVisionPanel.Views.UserControls"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="58" d:DesignWidth="220">
    <UserControl.Resources>
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
           
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2C3E50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                                <Setter Property="Background" Value="#21618C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                              
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent" Padding="2" CornerRadius="5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <!-- Start Button -->
            <Button Command="{Binding StartCommand}" 
                    Style="{StaticResource ControlButtonStyle}"
                    IsEnabled="{Binding StartButtonEnabled}"
                     Background="{Binding StartButtonColor}"
                    ToolTip="{Binding StartButtonText}">
                <StackPanel Orientation="Vertical">
                    <fa:ImageAwesome Icon="Play" Width="22" Height="22" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding StartButtonText}" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <!-- Stop Button -->
            <Button Command="{Binding StopCommand}" 
                    Style="{StaticResource ControlButtonStyle}"
                    IsEnabled="{Binding StopButtonEnabled}"
                     Background="{Binding StopButtonColor}"
                    ToolTip="{Binding StopButtonText}">
                <StackPanel Orientation="Vertical">
                    <fa:ImageAwesome Icon="Stop" Width="22" Height="22" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding StopButtonText}" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <!-- Restart Button -->
            <Button Command="{Binding RestartCommand}" 
                    Style="{StaticResource ControlButtonStyle}"
                    Background="#E74C3C"
                    ToolTip="{Binding CloseButtonToolTip}">
                <StackPanel Orientation="Vertical">
                    <fa:ImageAwesome Icon="PowerOff" Width="22" Height="22" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding CloseButtonText}" FontWeight="Bold"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Border>
</UserControl>
