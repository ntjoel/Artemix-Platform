<UserControl x:Class="QtisVisionPanel.Views.UserControls.DisplayRecord.RightCameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QtisVisionPanel.Views.UserControls.DisplayRecord"
             xmlns:cog="clr-namespace:Cognex.VisionPro;assembly=Cognex.VisionPro.Controls"
             mc:Ignorable="d"
             MinWidth="0"
             MinHeight="0">
    <Border Margin="5"
            BorderBrush="#BDC3C7"
            BorderThickness="2"
            CornerRadius="5">
        <StackPanel Background="White">
            <WindowsFormsHost Height="{Binding DisplayHostHeight, FallbackValue=230}"
                              MinHeight="{Binding DisplayHostMinHeight, FallbackValue=145}"
                              Margin="4,4,4,0"
                              HorizontalAlignment="Stretch">
                <cog:CogRecordDisplay x:Name="CogRecordsDisplay1"/>
            </WindowsFormsHost>

            <WindowsFormsHost Height="24" Margin="4,0" HorizontalAlignment="Stretch">
                <cog:CogDisplayStatusBarV2 x:Name="CogDisplayStatusBarV21"/>
            </WindowsFormsHost>

            <DockPanel Background="#FFE6E2E2" LastChildFill="True">
                <TextBox x:Name="RunStatusTextBox"
                         x:FieldModifier="public"
                         BorderThickness="2"
                         IsReadOnly="True"
                         TextWrapping="Wrap"/>
            </DockPanel>

            <Border x:Name="FeatureCardBorder" BorderThickness="2" CornerRadius="5"
                    BorderBrush="#BDC3C7" Background="Transparent">
                <StackPanel>
                    <Label x:Name="lbRightCamera"
                           HorizontalAlignment="Center"
                           Content="Right Camera Features"
                           FontSize="{DynamicResource CameraFeatureLabelFontSize}"
                           FontWeight="Bold"/>
                    <Border MinHeight="48" Margin="4" Background="Transparent">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Grid x:Name="SealingFeatureContainer"
                                  Width="{DynamicResource CameraFeatureIconSize}"
                                  Height="{DynamicResource CameraFeatureIconSize}"
                                  Margin="{DynamicResource CameraFeatureIconMargin}">
                                <Image Source="{StaticResource InspIcon_SideSealing}" Stretch="Uniform"/>
                                <Border x:Name="SealingStatusOverlay"
                                        Width="16" Height="16"
                                        Margin="0,0,-2,-2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock x:Name="SealingStatusText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="Yellow"
                                               Text="?"/>
                                </Border>
                            </Grid>

                            <Grid x:Name="ShapeSideFeatureContainer"
                                  Width="{DynamicResource CameraFeatureIconSize}"
                                  Height="{DynamicResource CameraFeatureIconSize}"
                                  Margin="{DynamicResource CameraFeatureIconMargin}">
                                <Image Source="{StaticResource InspIcon_ShapeSide}" Stretch="Uniform"/>
                                <Border x:Name="ShapeSideStatusOverlay"
                                        Width="16" Height="16"
                                        Margin="0,0,-2,-2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock x:Name="ShapeSideStatusText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="Yellow"
                                               Text="?"/>
                                </Border>
                            </Grid>

                            <Grid x:Name="RollCountFeatureContainer"
                                  Width="{DynamicResource CameraFeatureIconSize}"
                                  Height="{DynamicResource CameraFeatureIconSize}"
                                  Margin="{DynamicResource CameraFeatureIconMargin}">
                                <Image Source="{StaticResource InspIcon_SideRollCount}" Stretch="Uniform"/>
                                <Border x:Name="RollCountStatusOverlay"
                                        Width="16" Height="16"
                                        Margin="0,0,-2,-2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock x:Name="RollCountStatusText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="Yellow"
                                               Text="?"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <local:ClassificationFeatureCard x:Name="ClassificationSummaryCard"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
