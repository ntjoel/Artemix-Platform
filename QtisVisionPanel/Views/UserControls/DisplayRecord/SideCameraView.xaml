<UserControl x:Class="QtisVisionPanel.Views.UserControls.DisplayRecord.SideCameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QtisVisionPanel.Views.UserControls.DisplayRecord"
             xmlns:cog="clr-namespace:Cognex.VisionPro;assembly=Cognex.VisionPro.Controls"
             mc:Ignorable="d" 
             MinWidth="0" MinHeight="0">

    <Border BorderThickness="2" CornerRadius="5" BorderBrush="#BDC3C7" Margin="5">
        <Grid>

            <StackPanel Background="White" Orientation="Vertical">
                <WindowsFormsHost Height="{Binding DisplayHostHeight, FallbackValue=230}" MinHeight="{Binding DisplayHostMinHeight, FallbackValue=145}" HorizontalAlignment="Stretch" Margin="4,4,4,0">
                    <cog:CogRecordDisplay x:Name="CogRecordsDisplay1"/>
                </WindowsFormsHost>

                <WindowsFormsHost Height="24" HorizontalAlignment="Stretch" Margin="4,0,4,0">
                    <cog:CogDisplayStatusBarV2 x:Name="CogDisplayStatusBarV21"/>
                </WindowsFormsHost>
                <DockPanel LastChildFill="True"  Grid.Row="2" Background="#FFE6E2E2">
                    <TextBox x:Name="RunStatusTextBox" Grid.Row="2" 
x:FieldModifier="public"
TextWrapping="Wrap" 
Text="" 
BorderThickness="2"/>
                </DockPanel>
                <Border x:Name="FeatureCardBorder" BorderThickness="2" CornerRadius="5"
                        BorderBrush="#BDC3C7" Background="Transparent">
                    <StackPanel Orientation="Vertical">
                        <Label Content="Side Camera Features" x:Name="lbSideCamera" HorizontalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource CameraFeatureLabelFontSize}"/>
                        <Border x:Name="FeatureSummaryBorder" MinHeight="48" Background="Transparent" Margin="4" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Open Flaps Side -->
                                <Grid x:Name="HeightFeatureContainer" Width="{DynamicResource CameraFeatureIconSize}" Height="{DynamicResource CameraFeatureIconSize}" Margin="{DynamicResource CameraFeatureIconMargin}">
                                    <Image Source="{StaticResource InspIcon_Height}" Stretch="Uniform"/>
                                    <Border x:Name="OpenFlapsSideStatusOverlay"
                    Width="16" Height="16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,-2,-2"
                    Background="White"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="Black">
                                        <TextBlock x:Name="OpenFlapsSideStatusText"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          FontSize="10" FontWeight="Bold"
                          Text="?" Foreground="Yellow"/>
                                    </Border>
                                </Grid>

                                <!-- Sealing Side -->
                                <Grid x:Name="SealingFeatureContainer" Width="{DynamicResource CameraFeatureIconSize}" Height="{DynamicResource CameraFeatureIconSize}" Margin="{DynamicResource CameraFeatureIconMargin}">
                                    <Image Source="{StaticResource InspIcon_SideSealing}" Stretch="Uniform"/>
                                    <Border x:Name="OpenSealingSideStatusOverlay"
                    Width="16" Height="16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,-2,-2"
                    Background="White"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="Black">
                                        <TextBlock x:Name="OpenSealingSideStatusText"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          FontSize="10" FontWeight="Bold"
                          Text="?" Foreground="Yellow"/>
                                    </Border>
                                </Grid>

                                <!-- Shape Side -->
                                <Grid x:Name="ShapeSideFeatureContainer" Width="{DynamicResource CameraFeatureIconSize}" Height="{DynamicResource CameraFeatureIconSize}" Margin="{DynamicResource CameraFeatureIconMargin}">
                                    <Image Source="{StaticResource InspIcon_ShapeSide}" Stretch="Uniform"/>
                                    <Border x:Name="ShapeSideStatusOverlay"
                    Width="16" Height="16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,-2,-2"
                    Background="White"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="Black">
                                        <TextBlock x:Name="ShapeSideStatusText"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          FontSize="10" FontWeight="Bold"
                          Text="?" Foreground="Yellow"/>
                                    </Border>
                                </Grid>

                                <!-- Roll Count Side/Left -->
                                <Grid x:Name="SideRollCountFeatureContainer" Width="{DynamicResource CameraFeatureIconSize}" Height="{DynamicResource CameraFeatureIconSize}" Margin="{DynamicResource CameraFeatureIconMargin}">
                                    <Image Source="{StaticResource InspIcon_SideRollCount}" Stretch="Uniform"/>
                                    <Border x:Name="SideRollCountStatusOverlay"
                    Width="16" Height="16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,-2,-2"
                    Background="White"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="Black">
                                        <TextBlock x:Name="SideRollCountStatusText"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          FontSize="10" FontWeight="Bold"
                          Text="?" Foreground="Yellow"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <local:ClassificationFeatureCard x:Name="ClassificationSummaryCard"/>
                        <StackPanel x:Name="ThreeDMeasurementPanel" Margin="8,0,8,8" Visibility="Collapsed">
                            <Border x:Name="ThreeDSecondaryCard1"
                                    CornerRadius="8"
                                    BorderBrush="#D7E2EC"
                                    BorderThickness="1"
                                    Background="#F7F9FC"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Row="0"
                                           Grid.RowSpan="2"
                                           Grid.Column="0"
                                           Width="46"
                                           Height="46"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Source="{StaticResource InspIcon_ThreeDWidth}"
                                           Stretch="Uniform"/>
                                    <TextBlock x:Name="ThreeDSecondaryLabelText1"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               FontWeight="Bold"
                                               Foreground="#1F3B57"/>
                                    <Border x:Name="ThreeDSecondaryStatusBadge1"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            Background="#D9E3EC">
                                        <TextBlock x:Name="ThreeDSecondaryStatusText1"
                                                   FontWeight="Bold"
                                                   Foreground="#1F3B57"/>
                                    </Border>
                                    <TextBlock x:Name="ThreeDSecondarySummaryText1"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#2D4B63"
                                               FontSize="11"/>
                                </Grid>
                            </Border>

                            <Border x:Name="ThreeDSecondaryCard2"
                                    CornerRadius="8"
                                    BorderBrush="#D7E2EC"
                                    BorderThickness="1"
                                    Background="#F7F9FC"
                                    Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Row="0"
                                           Grid.RowSpan="2"
                                           Grid.Column="0"
                                           Width="46"
                                           Height="46"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Source="{StaticResource InspIcon_ThreeDLength}"
                                           Stretch="Uniform"/>
                                    <TextBlock x:Name="ThreeDSecondaryLabelText2"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               FontWeight="Bold"
                                               Foreground="#1F3B57"/>
                                    <Border x:Name="ThreeDSecondaryStatusBadge2"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            Background="#D9E3EC">
                                        <TextBlock x:Name="ThreeDSecondaryStatusText2"
                                                   FontWeight="Bold"
                                                   Foreground="#1F3B57"/>
                                    </Border>
                                    <TextBlock x:Name="ThreeDSecondarySummaryText2"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#2D4B63"
                                               FontSize="11"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>
    </Border>
</UserControl>
