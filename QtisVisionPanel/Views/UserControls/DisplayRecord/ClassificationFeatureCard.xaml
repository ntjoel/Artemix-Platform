<UserControl x:Class="QtisVisionPanel.Views.UserControls.DisplayRecord.ClassificationFeatureCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0"
             Visibility="Collapsed">
    <Border x:Name="CardBorder"
            Margin="8,0,8,8"
            Padding="8"
            Background="#F0F6FB"
            BorderBrush="#75A9D1"
            BorderThickness="1"
            CornerRadius="8">
        <Grid MinWidth="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Row="0"
                     Grid.RowSpan="2"
                     Grid.Column="0"
                     Width="44"
                     Height="44"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center">
                <Grid Width="48" Height="48">
                    <Border x:Name="IconFrame"
                            Margin="3"
                            Background="#E1EFF9"
                            BorderBrush="#2F80C3"
                            BorderThickness="2"
                            CornerRadius="8"/>
                    <Canvas Width="48" Height="48">
                        <Line X1="9" Y1="14" X2="4" Y2="14" Stroke="#2F80C3" StrokeThickness="2"/>
                        <Line X1="9" Y1="24" X2="4" Y2="24" Stroke="#2F80C3" StrokeThickness="2"/>
                        <Line X1="9" Y1="34" X2="4" Y2="34" Stroke="#2F80C3" StrokeThickness="2"/>
                        <Line X1="44" Y1="14" X2="39" Y2="14" Stroke="#2F80C3" StrokeThickness="2"/>
                        <Line X1="44" Y1="24" X2="39" Y2="24" Stroke="#2F80C3" StrokeThickness="2"/>
                        <Line X1="44" Y1="34" X2="39" Y2="34" Stroke="#2F80C3" StrokeThickness="2"/>
                    </Canvas>
                    <TextBlock x:Name="IconText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1F5F91"
                               Text="AI"/>
                </Grid>
            </Viewbox>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Grid.Column="1"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#1F3B57"
                       Text="AI classification"
                       TextTrimming="CharacterEllipsis"/>

            <Border x:Name="StatusBadge"
                    Grid.Row="0"
                    Grid.Column="2"
                    MinWidth="58"
                    Padding="8,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#2F80C3"
                    CornerRadius="10">
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Center"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="RESULT"/>
            </Border>

            <TextBlock x:Name="SummaryText"
                       Grid.Row="1"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Margin="0,5,0,0"
                       Foreground="#2D4B63"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
