<UserControl x:Class="QtisVisionPanel.Views.UserControls.DisplayRecord.FrontCameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QtisVisionPanel.Views.UserControls.DisplayRecord"
             xmlns:cog="clr-namespace:Cognex.VisionPro;assembly=Cognex.VisionPro.Controls"
             mc:Ignorable="d" 
             MinWidth="0" MinHeight="0">
    <Border BorderThickness="2" CornerRadius="5" BorderBrush="#BDC3C7" Margin="5">
        <Grid>

            <StackPanel Background="White" Orientation="Vertical">
                <WindowsFormsHost Height="{Binding DisplayHostHeight, FallbackValue=230}" MinHeight="{Binding DisplayHostMinHeight, FallbackValue=145}" HorizontalAlignment="Stretch" Margin="4,4,4,0">
                    <cog:CogRecordDisplay x:Name="CogRecordsDisplay1"/>
                </WindowsFormsHost>

                <WindowsFormsHost Height="24" HorizontalAlignment="Stretch" Margin="4,0,4,0">
                    <cog:CogDisplayStatusBarV2 x:Name="CogDisplayStatusBarV21"/>
                </WindowsFormsHost>
                <DockPanel LastChildFill="True"  Grid.Row="2" Background="#FFE6E2E2">
                    <TextBox x:Name="RunStatusTextBox" Grid.Row="2" 
x:FieldModifier="public"
TextWrapping="Wrap" 
Text="" 
BorderThickness="2"/>
                </DockPanel>
                <Border x:Name="FeatureCardBorder" BorderThickness="2" CornerRadius="5"
                        BorderBrush="#BDC3C7" Background="Transparent">
                    <StackPanel Orientation="Vertical">
                        <Label Content="Front Camera Features" x:Name="lbfrontCamera" HorizontalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource CameraFeatureLabelFontSize}"/>
                        <Border x:Name="TraceabilityFeatureContainer" BorderThickness="1" CornerRadius="5" MinHeight="72" Background="#F8FBFF" BorderBrush="#D5E2EE" Margin="4" HorizontalAlignment="Stretch" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TraceabilityStatusLabel"
                                           Grid.Row="0"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Text="Traceability status"/>
                                <TextBlock x:Name="TraceabilityStatusValueText"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           FontWeight="Bold"
                                           Foreground="#B8860B"
                                           Text="Waiting result"/>

                                <TextBlock x:Name="TraceabilityCodeLabel"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="0,6,0,0"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Text="Detected code"/>
                                <TextBlock x:Name="TraceabilityCodeValueText"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="-" />

                                <TextBlock x:Name="ExpectedPrefixLabel"
                                           Grid.Row="2"
                                           Grid.Column="0"
                                           Margin="0,6,0,0"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Text="Expected prefix"/>
                                <TextBlock x:Name="ExpectedPrefixValueText"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="0,6,0,0"
                                           Text="-"/>
                            </Grid>
                        </Border>
                        <local:ClassificationFeatureCard x:Name="ClassificationSummaryCard"/>
                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>
    </Border>
</UserControl>
