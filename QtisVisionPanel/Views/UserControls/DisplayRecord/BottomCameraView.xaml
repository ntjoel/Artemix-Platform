<UserControl x:Class="QtisVisionPanel.Views.UserControls.DisplayRecord.BottomCameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QtisVisionPanel.Views.UserControls.DisplayRecord"
             xmlns:cog="clr-namespace:Cognex.VisionPro;assembly=Cognex.VisionPro.Controls"
            
             MinWidth="0" MinHeight="0">
    <Border BorderThickness="2" CornerRadius="5" BorderBrush="#BDC3C7" Margin="5">
        <Grid>

            <StackPanel Background="White" Orientation="Vertical">
                <WindowsFormsHost Height="{Binding DisplayHostHeight, FallbackValue=230}" MinHeight="{Binding DisplayHostMinHeight, FallbackValue=145}" HorizontalAlignment="Stretch" Margin="4,4,4,0">
                    <cog:CogRecordDisplay x:Name="CogRecordsDisplay1"/>
                </WindowsFormsHost>

                <WindowsFormsHost Height="24" HorizontalAlignment="Stretch" Margin="4,0,4,0">
                    <cog:CogDisplayStatusBarV2 x:Name="CogDisplayStatusBarV21"/>
                </WindowsFormsHost>
                <DockPanel LastChildFill="True"  Grid.Row="2" Background="#FFE6E2E2">
                    <TextBox x:Name="RunStatusTextBox" Grid.Row="2" 
x:FieldModifier="public"
TextWrapping="Wrap" 
Text="" 
BorderThickness="2"/>
                </DockPanel>
                <Border x:Name="FeatureCardBorder" BorderThickness="2" CornerRadius="5"
                        BorderBrush="#BDC3C7" Background="Transparent">
                    <StackPanel Orientation="Vertical">
                        <Label Content="Bottom Camera" x:Name="lbbottom" HorizontalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource CameraFeatureLabelFontSize}"/>
                        <Border x:Name="FeatureSummaryBorder" MinHeight="48" Background="Transparent" Margin="4" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Grid x:Name="BottomSealingFeatureContainer" Width="{DynamicResource CameraFeatureIconSize}" Height="{DynamicResource CameraFeatureIconSize}" Margin="{DynamicResource CameraFeatureIconMargin}">
                                    <Image Source="{StaticResource InspIcon_BottomSealing}" Stretch="Uniform"/>
                                    <Border x:Name="BottomSealingStatusOverlay"
                                            Width="16" Height="16"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,-2,-2"
                                            Background="White"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="Black">
                                        <TextBlock x:Name="BottomSealingStatusText"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="10" FontWeight="Bold"
                                                   Text="?" Foreground="Yellow"/>
                                    </Border>
                                </Grid>

                                <Grid x:Name="TrappedPaperFeatureContainer" Width="{DynamicResource CameraFeatureIconSize}" Height="{DynamicResource CameraFeatureIconSize}" Margin="{DynamicResource CameraFeatureIconMargin}">
                                    <Image Source="{StaticResource InspIcon_TrappedPaper}" Stretch="Uniform"/>
                                    <Border x:Name="TrappedPaperStatusOverlay"
                                            Width="16" Height="16"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,-2,-2"
                                            Background="White"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="Black">
                                        <TextBlock x:Name="TrappedPaperStatusText"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="10" FontWeight="Bold"
                                                   Text="?" Foreground="Yellow"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <local:ClassificationFeatureCard x:Name="ClassificationSummaryCard"/>
                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>
    </Border>
</UserControl>
