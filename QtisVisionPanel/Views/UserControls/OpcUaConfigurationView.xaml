<UserControl x:Class="QtisVisionPanel.Views.UserControls.OpcUaConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:QtisVisionPanel.Models"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1360"
             Background="#F4F8FC">
    <UserControl.Resources>
        <models:BindingProxy x:Key="VmProxy" Data="{Binding}"/>

        <SolidColorBrush x:Key="OpcBackground" Color="#F4F8FC"/>
        <SolidColorBrush x:Key="OpcSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OpcStroke" Color="#D6E2F0"/>
        <SolidColorBrush x:Key="OpcInk" Color="#102A43"/>
        <SolidColorBrush x:Key="OpcMuted" Color="#62788F"/>
        <SolidColorBrush x:Key="OpcAccent" Color="#2378B7"/>
        <SolidColorBrush x:Key="OpcGreen" Color="#2E9E75"/>
        <SolidColorBrush x:Key="OpcWarning" Color="#C88719"/>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource OpcSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OpcStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OpcMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OpcInk}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OpcInk}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#B9CBDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{StaticResource OpcAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource OpcAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#EAF2F8"/>
            <Setter Property="Foreground" Value="{StaticResource OpcInk}"/>
            <Setter Property="BorderBrush" Value="#C8D9EA"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OpcBackground}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#142B46" CornerRadius="18" Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="#BFD3EA" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="{Binding ReconnectLabel}" Command="{Binding ReconnectCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="{Binding DisconnectLabel}" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ServerSettingsLabel}" Style="{StaticResource SectionTitleStyle}"/>

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <CheckBox Content="{Binding EnabledLabel}" IsChecked="{Binding Enabled}" Margin="0,0,12,8"/>
                                <CheckBox Content="{Binding RequiredLabel}" IsChecked="{Binding RequiredForMachineRun}" Margin="0,0,0,8"/>
                                <CheckBox Content="{Binding UseDatabaseLabel}" IsChecked="{Binding UseDatabaseConfiguration}" Margin="0,0,12,8"/>
                                <CheckBox Content="{Binding UseSecurityLabel}" IsChecked="{Binding UseSecurity}" Margin="0,0,0,8"/>
                                <CheckBox Content="{Binding AutoAcceptLabel}" IsChecked="{Binding AutoAcceptUntrustedCertificates}" Margin="0,0,12,8"/>
                                <CheckBox Content="{Binding RemoteCommandsLabel}" IsChecked="{Binding RemoteCommandsEnabled}" Margin="0,0,0,8"/>
                                <CheckBox Content="{Binding RemoteStartStopLabel}" IsChecked="{Binding RemoteStartStopEnabled}" Margin="0,0,12,8"/>
                                <CheckBox Content="{Binding RemoteRecipeChangeLabel}" IsChecked="{Binding RemoteRecipeChangeEnabled}" Margin="0,0,0,8"/>
                                <CheckBox Content="{Binding AuditRemoteCommandsLabel}" IsChecked="{Binding AuditRemoteCommandsToDatabase}" Margin="0,0,12,8"/>
                            </UniformGrid>

                            <TextBlock Text="{Binding ServerUrlLabel}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,10"/>

                            <TextBlock Text="{Binding ApplicationNameLabel}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding ReconnectIntervalLabel}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding ReconnectIntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding SubscriptionIntervalLabel}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding SubscriptionIntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,10"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SessionTimeoutLabel}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding SessionTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding OperationTimeoutLabel}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding OperationTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding DirectionDiagramLabel}" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Height="190">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#EAF2F8" BorderBrush="#C8D9EA" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ServerSideLabel}" Foreground="{StaticResource OpcInk}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ServerToClientCountText}" Foreground="{StaticResource OpcMuted}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#EAF7F1" BorderBrush="#CBE8DA" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClientSideLabel}" Foreground="{StaticResource OpcInk}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ClientToServerCountText}" Foreground="{StaticResource OpcMuted}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False">
                                    <Line X1="120" Y1="76" X2="300" Y2="76" Stroke="{StaticResource OpcAccent}" StrokeThickness="4"/>
                                    <Polygon Points="300,76 286,68 286,84" Fill="{StaticResource OpcAccent}"/>
                                    <TextBlock Canvas.Left="132" Canvas.Top="50" Text="{Binding ServerToClientLabel}" Foreground="{StaticResource OpcAccent}" FontWeight="SemiBold"/>

                                    <Line X1="300" Y1="122" X2="120" Y2="122" Stroke="{StaticResource OpcGreen}" StrokeThickness="4"/>
                                    <Polygon Points="120,122 134,114 134,130" Fill="{StaticResource OpcGreen}"/>
                                    <TextBlock Canvas.Left="132" Canvas.Top="132" Text="{Binding ClientToServerLabel}" Foreground="{StaticResource OpcGreen}" FontWeight="SemiBold"/>
                                </Canvas>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource ValueStyle}" Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding RuntimeStatusLabel}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding RuntimeStatusText}" Style="{StaticResource ValueStyle}" Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding ConfigPathLabel}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding ConfigPath}" Foreground="{StaticResource OpcMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding TagsLabel}" Style="{StaticResource SectionTitleStyle}"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Nodes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              AlternatingRowBackground="#F7FAFD"
                              SelectionMode="Single"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="{Binding Data.EnabledHeader, Source={StaticResource VmProxy}}"
                                                    Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="70"/>
                            <DataGridTextColumn Header="{Binding Data.TagKeyHeader, Source={StaticResource VmProxy}}"
                                                Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                Width="145"/>
                            <DataGridTextColumn Header="{Binding Data.NodeIdHeader, Source={StaticResource VmProxy}}"
                                                Binding="{Binding NodeId, UpdateSourceTrigger=PropertyChanged}"
                                                Width="310"/>
                            <DataGridTemplateColumn Header="{Binding Data.DirectionHeader, Source={StaticResource VmProxy}}" Width="165">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding DirectionBrush}" Padding="8,3" CornerRadius="8" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding DirectionText}" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Data.DirectionOptions, Source={StaticResource VmProxy}}"
                                                  SelectedItem="{Binding Direction, UpdateSourceTrigger=PropertyChanged}"
                                                  MinWidth="145"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridComboBoxColumn Header="{Binding Data.DataTypeHeader, Source={StaticResource VmProxy}}"
                                                    ItemsSource="{Binding Data.DataTypeOptions, Source={StaticResource VmProxy}}"
                                                    SelectedItemBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="90"/>
                            <DataGridCheckBoxColumn Header="{Binding Data.RequiredHeader, Source={StaticResource VmProxy}}"
                                                    Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="80"/>
                            <DataGridTextColumn Header="{Binding Data.DescriptionHeader, Source={StaticResource VmProxy}}"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"
                                                MinWidth="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFF7E6" BorderBrush="#F0D39A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
            <TextBlock Text="{Binding OperatorMessage}" Foreground="{StaticResource OpcWarning}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
