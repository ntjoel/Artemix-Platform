<UserControl x:Class="QtisVisionPanel.Views.UserControls.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="#F4F8FC">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6E2F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6E2F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F738A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#102A43" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#142B46"
                CornerRadius="22"
                Padding="20,16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="Sub_entry_EventsMonitorTitle"
                               Text="Events Monitor"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock x:Name="Sub_entry_EventsMonitorSubtitle"
                               Text="Storico eventi applicativi, stati macchina ed eccezioni diagnostiche"
                               Foreground="#BFD3EA"
                               FontSize="13"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="Sub_entry_LastRefreshLabel"
                               Text="{Binding LastRefreshDisplayText}"
                               Foreground="#DCE7F5"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0" />
                    <Button x:Name="Sub_entry_RefreshButton"
                            Content="Aggiorna"
                            Command="{Binding RefreshCommand}"
                            MinWidth="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Background="#2C79B8"
                            Foreground="White"
                            BorderBrush="#2C79B8" />
                    <Button x:Name="Sub_entry_ClearEventsButton"
                            Content="Svuota eventi"
                            Command="{Binding ClearEventsCommand}"
                            Visibility="{Binding CanManageEventMaintenance, Converter={StaticResource BoolToVis}}"
                            MinWidth="120"
                            Height="34"
                            Margin="0,0,10,0"
                            Background="#D64545"
                            Foreground="White"
                            BorderBrush="#D64545" />
                    <Button x:Name="Sub_entry_ClearWarningInfoButton"
                            Content="Elimina W/I"
                            Command="{Binding ClearWarningInfoCommand}"
                            Visibility="{Binding CanManageEventMaintenance, Converter={StaticResource BoolToVis}}"
                            MinWidth="120"
                            Height="34"
                            Margin="0,0,10,0"
                            Background="#F29D38"
                            Foreground="White"
                            BorderBrush="#F29D38" />
                    <Button x:Name="Sub_entry_ClearOlderButton"
                            Content="Elimina &gt;1g"
                            Command="{Binding ClearOlderThanOneDayCommand}"
                            Visibility="{Binding CanManageEventMaintenance, Converter={StaticResource BoolToVis}}"
                            MinWidth="120"
                            Height="34"
                            Margin="0,0,10,0"
                            Background="#6C7A89"
                            Foreground="White"
                            BorderBrush="#6C7A89" />
                    <CheckBox x:Name="Sub_entry_AutoRefreshCheck"
                              Content="Auto refresh"
                              IsChecked="{Binding AutoRefresh}"
                              VerticalAlignment="Center"
                              Foreground="White"
                              FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="2.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="Sub_entry_TotalEventsLabel" Text="Totale eventi" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding TotalEvents}" Style="{StaticResource ValueStyle}" FontSize="28" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="Sub_entry_WarningLabel" Text="Warning" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding WarningEvents}" Style="{StaticResource ValueStyle}" FontSize="28" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="Sub_entry_ErrorsCriticalLabel" Text="Errori / Critical" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding ErrorEvents}" Style="{StaticResource ValueStyle}" FontSize="28" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="Sub_entry_DatabaseStatusLabel" Text="Database" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding DatabaseStatus}" Style="{StaticResource ValueStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="Sub_entry_VisionProStatusLabel" Text="VisionPro" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding VisionProStatus}" Style="{StaticResource ValueStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="5"
                    CornerRadius="18"
                    Background="White"
                    BorderBrush="#D6E2F0"
                    BorderThickness="1"
                    Padding="16,14"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             VerticalContentAlignment="Center"
                             Margin="0,0,12,0"
                             Padding="10,0"
                             BorderBrush="#C5D5E6"
                             TextWrapping="NoWrap" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LevelOptions}"
                              SelectedItem="{Binding SelectedLevel}"
                              Height="36"
                              Margin="0,0,12,0"
                              BorderBrush="#C5D5E6" />

                    <Button Grid.Column="2"
                            x:Name="Sub_entry_ClearFiltersButton"
                            Content="Pulisci filtri"
                            Command="{Binding ClearFiltersCommand}"
                            Height="36"
                            MinWidth="110"
                            Background="#EEF4FB"
                            BorderBrush="#C5D5E6"
                            Foreground="#17324D" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource PanelCardStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="12"
                        CornerRadius="999"
                        Background="{Binding DiagnosticsStatusBrush}"
                        Margin="0,0,16,0" />

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Sub_entry_PCDiagnosticsCardTitle"
                               Text="PC diagnostics"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#102A43" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding DiagnosticsStatusText}"
                                   Foreground="#17324D"
                                   FontWeight="SemiBold"
                                   Margin="0,0,16,0" />
                        <TextBlock Text="{Binding DiagnosticsCpuDisplay}"
                                   Foreground="#5F738A"
                                   Margin="0,0,16,0" />
                        <TextBlock Text="{Binding DiagnosticsRamDisplay}"
                                   Foreground="#5F738A"
                                   Margin="0,0,16,0" />
                        <TextBlock Text="{Binding DiagnosticsDiskDisplay}"
                                   Foreground="#5F738A"
                                   Margin="0,0,16,0" />
                        <TextBlock Text="{Binding DiagnosticsCleanupText}"
                                   Foreground="#5F738A"
                                   TextTrimming="CharacterEllipsis" />
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#EEF4FB"
                            BorderBrush="#C5D5E6"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="12,6"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding DiagnosticsAlertCountText}"
                                   Foreground="#17324D"
                                   FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="Sub_entry_OpenSystemDiagnosticsButton"
                            Content="Apri diagnostica PC"
                            Command="{Binding OpenSystemDiagnosticsCommand}"
                            IsEnabled="{Binding CanOpenSystemDiagnostics}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding SystemDiagnosticsPermissionToolTip}"
                            Height="36"
                            MinWidth="150"
                            Background="#2C79B8"
                            Foreground="White"
                            BorderBrush="#2C79B8" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelCardStyle}"
                    Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="Sub_entry_EventStreamTitle"
                                   Text="Event Stream"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#102A43" />
                        <TextBlock x:Name="Sub_entry_EventStreamHint"
                                   Text="Storico recente degli eventi registrati in `tbllogevent`"
                                   FontSize="12"
                                   Foreground="#6B7C93"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding EventsView}"
                              SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              AlternatingRowBackground="#F7FAFD"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn x:Name="Sub_entry_LevelColumn" Header="Livello" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding LevelBrush}"
                                                CornerRadius="10"
                                                Padding="8,4"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding LevelText}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="Sub_entry_TimestampColumn" Header="Timestamp"
                                                Width="150"
                                                Binding="{Binding Timestamp, StringFormat=dd/MM/yyyy HH:mm:ss}" />
                            <DataGridTextColumn x:Name="Sub_entry_CategoryColumn" Header="Categoria"
                                                Width="120"
                                                Binding="{Binding Category}" />
                            <DataGridTextColumn x:Name="Sub_entry_CodeColumn" Header="Codice"
                                                Width="160"
                                                Binding="{Binding LogId}" />
                            <DataGridTextColumn x:Name="Sub_entry_MessageColumn" Header="Messaggio"
                                                Width="*"
                                                Binding="{Binding Message}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Background="#F6FAFE"
                            CornerRadius="14"
                            BorderBrush="#D6E2F0"
                            BorderThickness="1"
                            Padding="12,10"
                            Margin="0,12,0,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#36536E"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="Sub_entry_EventDetailsTitle" Text="Event Details"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#102A43" />
                        <TextBlock x:Name="Sub_entry_EventDetailsHint"
                                   Text="Dettaglio completo dell’evento selezionato"
                                   FontSize="12"
                                   Foreground="#6B7C93"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock x:Name="Sub_entry_MachineStatusDetailLabel" Text="Machine Status" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{Binding SelectedMachineStatus}" Style="{StaticResource ValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="Sub_entry_DatabaseStatusDetailLabel" Text="Database Status" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{Binding SelectedDatabaseStatus}" Style="{StaticResource ValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock x:Name="Sub_entry_VisionProStatusDetailLabel" Text="VisionPro Status" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{Binding SelectedVisionProStatus}" Style="{StaticResource ValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock x:Name="Sub_entry_OperatorRoleLabel" Text="Operatore / Ruolo" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{Binding SelectedUser}" Style="{StaticResource ValueStyle}" />
                                        <TextBlock Text="{Binding SelectedRole}" Foreground="#5F738A" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="#F8FBFF"
                                    BorderBrush="#D6E2F0"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="Sub_entry_TimestampDetailLabel" Grid.Row="0" Grid.Column="0" Text="Timestamp" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEvent.Timestamp, StringFormat=dd/MM/yyyy HH:mm:ss}" Style="{StaticResource ValueStyle}" />

                                    <TextBlock x:Name="Sub_entry_CategoryDetailLabel" Grid.Row="1" Grid.Column="0" Text="Categoria" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.Category, TargetNullValue=-}" Style="{StaticResource ValueStyle}" Margin="0,10,0,0" />

                                    <TextBlock x:Name="Sub_entry_SourceDetailLabel" Grid.Row="2" Grid.Column="0" Text="Sorgente" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEvent.Source, TargetNullValue=-}" Style="{StaticResource ValueStyle}" Margin="0,10,0,0" />

                                    <TextBlock x:Name="Sub_entry_RecipeDetailLabel" Grid.Row="3" Grid.Column="0" Text="Ricetta" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEvent.Recipe, TargetNullValue=-}" Style="{StaticResource ValueStyle}" Margin="0,10,0,0" />

                                    <TextBlock x:Name="Sub_entry_MessageDetailLabel" Grid.Row="4" Grid.Column="0" Text="Messaggio" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEvent.Message, TargetNullValue=-}" Style="{StaticResource ValueStyle}" Margin="0,10,0,0" />
                                </Grid>
                            </Border>

                            <Border Background="#FFFFFF"
                                    BorderBrush="#D6E2F0"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="Sub_entry_DetailsReasonLabel" Text="Dettagli / Motivo"
                                               Foreground="#102A43"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                    <TextBlock x:Name="Sub_entry_NoDetailsText" Text="{Binding SelectedEventFullDetailsDisplay}"
                                               Margin="0,10,0,0"
                                               Foreground="#36536E"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="#0F2740"
                                    CornerRadius="14"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="Sub_entry_PayloadJsonLabel" Text="Payload JSON"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                    <TextBox Text="{Binding SelectedEvent.PrettyInfoJson, Mode=OneWay}"
                                             Margin="0,10,0,0"
                                             Background="#17324D"
                                             Foreground="#E4EEF8"
                                             BorderThickness="0"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="180"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
