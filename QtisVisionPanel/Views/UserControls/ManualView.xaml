<UserControl x:Class="QtisVisionPanel.Views.UserControls.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:QtisVisionPanel.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="#F4F8FC">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BooleanToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter"/>
        <converters:ImagePathConverter x:Key="ManualImagePathConverter"/>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6E2F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2C79B8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C79B8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ZoomButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#173755"/>
            <Setter Property="BorderBrush" Value="#173755"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#142B46"
                CornerRadius="22"
                Padding="20,16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="Sub_entry_ManualTitleText"
                               Text="Manuale Operatore"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="Sub_entry_ManualSubtitleText"
                               Text="Guida pratica per muoversi nel pannello e gestire le operazioni principali"
                               Foreground="#BFD3EA"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="-"
                            Command="{Binding ZoomOutCommand}"
                            Style="{StaticResource ZoomButtonStyle}"/>
                    <Button Content="{Binding ZoomPercentage}"
                            Command="{Binding ResetZoomCommand}"
                            Style="{StaticResource ZoomButtonStyle}"
                            MinWidth="62"/>
                    <Button Content="+"
                            Command="{Binding ZoomInCommand}"
                            Style="{StaticResource ZoomButtonStyle}"/>
                    <Button x:Name="Sub_entry_ManualExportPdfButton"
                            Content="Esporta PDF"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#D71920"
                            BorderBrush="#D71920"/>
                    <Button x:Name="Sub_entry_ManualRefreshButton"
                            Content="Aggiorna"
                            Command="{Binding RefreshDocumentsCommand}"
                            Style="{StaticResource ActionButtonStyle}"/>
                    <Button x:Name="Sub_entry_ManualOpenFolderButton"
                            Content="Apri cartella"
                            Command="{Binding OpenManualFolderCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#173755"
                            BorderBrush="#173755"
                            Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="Sub_entry_ManualDocumentsHeader"
                                   Text="Documenti disponibili"
                                   Foreground="#102A43"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="Sub_entry_ManualDocumentsHint"
                                   Text="Procedure rapide, avvio, ricette e gestione allarmi"
                                   Foreground="#6B7C93"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Documents}"
                             SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14,12"
                                        Background="#F7FAFE"
                                        BorderBrush="#D6E2F0"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#12293F"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#6B7C93"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding CurrentTitle}"
                                   Foreground="#102A43"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentDescription}"
                                   Foreground="#6B7C93"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                            </StackPanel.LayoutTransform>

                            <Border Background="#F8FBFF"
                                    BorderBrush="#D6E2F0"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Height="280"
                                            CornerRadius="12"
                                            Background="#EAF2FB"
                                            BorderBrush="#D6E2F0"
                                            BorderThickness="1"
                                            Visibility="{Binding HasCurrentHeroImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Image Source="{Binding CurrentHeroImagePath, Converter={StaticResource ManualImagePathConverter}}"
                                               Stretch="Uniform"
                                               Margin="10"/>
                                    </Border>

                                    <Border Grid.Row="0"
                                            Height="180"
                                            CornerRadius="12"
                                            Background="#F3F7FB"
                                            BorderBrush="#D6E2F0"
                                            BorderThickness="1"
                                            Visibility="{Binding HasCurrentHeroImage, Converter={StaticResource BoolToVisibilityInverseConverter}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="Sub_entry_ManualPreviewUnavailableTitle"
                                                       Text="Anteprima documento non disponibile"
                                                       Foreground="#274766"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="Sub_entry_ManualPreviewUnavailableHint"
                                                       Text="Aggiungere un'immagine nel file .md o nella cartella Docs\\Manual\\Images"
                                                       Foreground="#6B7C93"
                                                       FontSize="12"
                                                       Margin="0,8,0,0"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding CurrentHeroImageCaption}"
                                               Foreground="#6B7C93"
                                               FontSize="11"
                                               Margin="0,10,0,0"
                                               Visibility="{Binding HasCurrentHeroImage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding CurrentSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,14"
                                                Padding="16"
                                                Background="#F8FBFF"
                                                BorderBrush="#D6E2F0"
                                                BorderThickness="1"
                                                CornerRadius="14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Heading}"
                                                           Foreground="#102A43"
                                                           FontSize="16"
                                                           FontWeight="Bold"/>

                                                <Border Margin="0,12,0,0"
                                                        Height="220"
                                                        Background="#EEF4FB"
                                                        BorderBrush="#D6E2F0"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ManualImagePathConverter}}"
                                                           Stretch="Uniform"
                                                           Margin="10"/>
                                                </Border>

                                                <TextBlock Text="{Binding ImageCaption}"
                                                           Foreground="#6B7C93"
                                                           FontSize="11"
                                                           Margin="0,8,0,0"
                                                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                <Border Margin="0,14,0,0"
                                                        BorderBrush="#C6D8EA"
                                                        BorderThickness="1"
                                                        Background="White"
                                                        CornerRadius="8"
                                                        Visibility="{Binding HasFunctionRows, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Grid MinWidth="880">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0" Background="#EAF2FB">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="0.38*"/>
                                                                <ColumnDefinition Width="1.1*"/>
                                                                <ColumnDefinition Width="1.6*"/>
                                                                <ColumnDefinition Width="1.6*"/>
                                                                <ColumnDefinition Width="1.4*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DataContext.ManualTableHeaderId, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" Foreground="#102A43" Padding="10,8" TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DataContext.ManualTableHeaderFunction, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" Foreground="#102A43" Padding="10,8" TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding DataContext.ManualTableHeaderMeaning, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" Foreground="#102A43" Padding="10,8" TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding DataContext.ManualTableHeaderAction, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" Foreground="#102A43" Padding="10,8" TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding DataContext.ManualTableHeaderSupport, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" Foreground="#102A43" Padding="10,8" TextWrapping="Wrap"/>
                                                        </Grid>

                                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding FunctionRows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Background="#FFFFFF">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="0.38*"/>
                                                                            <ColumnDefinition Width="1.1*"/>
                                                                            <ColumnDefinition Width="1.6*"/>
                                                                            <ColumnDefinition Width="1.6*"/>
                                                                            <ColumnDefinition Width="1.4*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.Resources>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#243B53"/>
                                                                                <Setter Property="FontSize" Value="12.5"/>
                                                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                                                <Setter Property="Padding" Value="10,8"/>
                                                                            </Style>
                                                                        </Grid.Resources>
                                                                        <Border Grid.Column="0" BorderBrush="#E3EDF7" BorderThickness="0,1,1,0">
                                                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" TextAlignment="Center" Foreground="#2C79B8"/>
                                                                        </Border>
                                                                        <Border Grid.Column="1" BorderBrush="#E3EDF7" BorderThickness="0,1,1,0">
                                                                            <TextBlock Text="{Binding Function}" FontWeight="SemiBold"/>
                                                                        </Border>
                                                                        <Border Grid.Column="2" BorderBrush="#E3EDF7" BorderThickness="0,1,1,0">
                                                                            <TextBlock Text="{Binding Meaning}"/>
                                                                        </Border>
                                                                        <Border Grid.Column="3" BorderBrush="#E3EDF7" BorderThickness="0,1,1,0">
                                                                            <TextBlock Text="{Binding OperatorAction}"/>
                                                                        </Border>
                                                                        <Border Grid.Column="4" BorderBrush="#E3EDF7" BorderThickness="0,1,0,0">
                                                                            <TextBlock Text="{Binding SupportCondition}"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>

                                                <TextBlock Text="{Binding Body}"
                                                           Foreground="#243B53"
                                                           FontSize="13"
                                                           Margin="0,12,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
