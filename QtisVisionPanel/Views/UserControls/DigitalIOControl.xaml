                                                <StackPanel Width="240" Margin="0,0,16,8">
                                                    <TextBlock Text="{Binding L10n[Tool_Encoder_TachometerSpeed]}" VerticalAlignment="Center"/>
                                                    <DockPanel Margin="0,4,0,0">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding L10n[Tool_Common_MetersPerMinute]}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <TextBox MinWidth="110" Text="{Binding EncoderCalibrationTachometerSpeedMetersPerMinute, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalTextBoxConverter}}"/>
                                                    </DockPanel>
                                                </StackPanel>

                                                <StackPanel Width="240" Margin="0,0,16,8">
                                                    <TextBlock Text="{Binding L10n[Tool_Encoder_HmiSpeed]}" VerticalAlignment="Center"/>
                                                    <DockPanel Margin="0,4,0,0">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding L10n[Tool_Common_MetersPerMinute]}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <TextBox MinWidth="110" Text="{Binding EncoderCalibrationHmiSpeedMetersPerMinute, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalTextBoxConverter}}"/>
                                                    </DockPanel>
                                                </StackPanel>

                                                <Button MinWidth="150" Content="{Binding L10n[Tool_Encoder_UseCurrentHmiSpeed]}" Command="{Binding CaptureCurrentEncoderCalibrationSpeedCommand}" Style="{StaticResource LightHeaderActionButtonStyle}" Margin="0,18,8,8"/>
                                                <Button MinWidth="150" Content="{Binding L10n[Tool_Encoder_ApplyTachometerCalibration]}" Command="{Binding ApplyEncoderTachometerCalibrationCommand}" Style="{StaticResource HeaderActionButtonStyle}" Margin="0,18,0,8"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding EncoderCalibrationSummary}" Margin="0,10,0,0" Foreground="#18354E" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L10n[Tool_Encoder_MainDiagnostics]}" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="{Binding EncoderDiagnosticGuidance}" Margin="0,6,0,0" Foreground="#697989" TextWrapping="Wrap"/>
                                    <Separator Margin="0,12,0,12"/>
                                    <UniformGrid Columns="1">
                                        <Border Background="#F6F9FC" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding L10n[Tool_Encoder_ProductReference]}" Foreground="#697989" FontSize="11"/>
                                                <TextBlock Text="{Binding L10n[Tool_Encoder_ProductReferenceHint]}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F6F9FC" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding L10n[Tool_Encoder_MachineZeroAbsolute]}" Foreground="#697989" FontSize="11"/>
                                                <TextBlock Text="{Binding MachineZeroSummary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding InterventionQuotaSummary}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#415463"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <Expander Header="{Binding L10n[Tool_Encoder_RawDetail]}" Margin="0,14,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding MainEncoderCountsSummary}" FontWeight="SemiBold" FontSize="16"/>
                                            <TextBlock Text="{Binding MainEncoderRawDeltaSummary}" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding MainEncoderRawSpeedSummary}" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding MainEncoderSampleSummary}" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding MainEncoderDiagnosticStateSummary}" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="#18354E"/>
                                            <Border Background="#FFF8E6" BorderBrush="#F2D48A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,0">
                                                <TextBlock Text="{Binding L10n[Tool_Encoder_RawDetailHint]}" TextWrapping="Wrap" Foreground="#6C5520"/>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,6,0,0">
