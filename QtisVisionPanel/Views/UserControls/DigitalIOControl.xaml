                            </Grid>
                        </Border>

                        <!-- The physical channel is assigned here; advanced signal metadata remains below. -->
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding L10n[Tool_IoSetup_QuickMappingTitle]}" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="{Binding L10n[Tool_IoSetup_QuickMappingHint]}" Style="{StaticResource PageHeaderHintStyle}" TextWrapping="Wrap"/>
