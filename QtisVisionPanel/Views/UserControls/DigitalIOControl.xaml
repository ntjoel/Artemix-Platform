                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="{Binding L10n[Tool_Dashboard_MainEncoder]}"/><Run Text=" "/><Run Text="{Binding BoundMainEncoderAxisCode}"/></TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>


            <TabItem Header="{Binding L10n[Sub_entry_EncoderPage]}" Visibility="Collapsed">
