                                            <Button Content="{Binding L10n[Tool_Events_ExportFusionSnapshot]}" Style="{StaticResource LightHeaderActionButtonStyle}" Command="{Binding ExportFusionSnapshotCommand}" Margin="0,0,8,0"/>
                                            <Button Content="{Binding L10n[Tool_Events_OpenFusionExports]}" Style="{StaticResource LightHeaderActionButtonStyle}" Command="{Binding OpenFusionExportFolderCommand}" Margin="0,0,8,0"/>
                                            <Button Content="{Binding L10n[Tool_Events_Clear]}" Style="{StaticResource LightHeaderActionButtonStyle}" Command="{Binding ClearMachineEventsCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <ListView Grid.Row="1" ItemsSource="{Binding MachineOperationalEvents}" Background="Transparent" BorderThickness="0">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MachineOperationalEventTemplate}"/>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding L10n[Sub_entry_TestIO]}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource PageSurfaceStyle}" Background="#E9F1F7">
                                    <StackPanel>
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding L10n[Tool_TestIO_Polling]}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Text="{Binding PollingInterval, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding L10n[Tool_Common_Milliseconds]}" VerticalAlignment="Center" Margin="6,0,20,0"/>
                                            <Button Content="{Binding L10n[Tool_TestIO_ReadInputs]}" Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding ReadInputsCommand}"/>
                                            <Button Content="{Binding L10n[Tool_TestIO_AllOutputsOn]}" Style="{StaticResource LightHeaderActionButtonStyle}" Command="{Binding SetAllOutputsHighCommand}"/>
                                            <Button Content="{Binding L10n[Tool_TestIO_AllOutputsOff]}" Style="{StaticResource LightHeaderActionButtonStyle}" Command="{Binding SetAllOutputsLowCommand}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding StatusMessage}" Margin="0,6,0,0" Foreground="#4A5A67" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource PageSurfaceStyle}" Background="#F8FAFB" Margin="0,8,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding L10n[Tool_TestIO_DiagnosticHeartbeat]}" Style="{StaticResource CardTitleStyle}"/>
                                            <Button Grid.Column="1" Content="{Binding HeartbeatIndicatorLabel}" Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding ToggleHeartbeatCommand}" Margin="12,0,0,0" VerticalAlignment="Top"/>
                                        </Grid>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding L10n[Tool_HeartbeatOutput]}" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding MachineOutputs}" DisplayMemberPath="SignalCode" SelectedValuePath="SignalCode" SelectedValue="{Binding BoundHeartbeatOutputSignalCode, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Style="{StaticResource CompactComboStyle}" Margin="0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding L10n[Tool_TestIO_Interval]}" Style="{StaticResource ConfigFieldLabelStyle}"/>
                                                <DockPanel LastChildFill="False">
                                                    <TextBox Width="74" Text="{Binding HeartbeatIntervalMs, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Style="{StaticResource CompactTextBoxStyle}" Margin="0"/>
                                                    <TextBlock Text="{Binding L10n[Tool_Common_Milliseconds]}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#697989"/>
                                                </DockPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                                <CheckBox Content="{Binding L10n[Tool_TestIO_Enabled]}" IsChecked="{Binding HeartbeatEnabled}" Margin="0,0,0,6" VerticalAlignment="Center"/>
                                                <CheckBox Content="{Binding L10n[Tool_TestIO_HwAutostart]}" IsChecked="{Binding HeartbeatAutoStartOnRealHardware}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,4,0,0">
                                            <TextBlock Text="{Binding HeartbeatTargetSummary}" Foreground="#18354E" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,3,0,0" Text="{Binding HeartbeatStatusSummary}" Foreground="#5B6C79" FontSize="10.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding L10n[Tool_TestIO_DigitalInputs]}" Style="{StaticResource CardTitleStyle}"/>
                                                <TextBlock DockPanel.Dock="Right" Foreground="#697989" Text="{Binding L10n[Tool_TestIO_DigitalInputsHint]}"/>
                                            </DockPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                                <ItemsControl ItemsSource="{Binding InputChannels}" ItemTemplate="{StaticResource InputChannelTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding L10n[Tool_TestIO_DigitalOutputs]}" Style="{StaticResource CardTitleStyle}"/>
                                                <TextBlock DockPanel.Dock="Right" Foreground="#697989" Text="{Binding L10n[Tool_TestIO_DigitalOutputsHint]}"/>
                                            </DockPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                                <ItemsControl ItemsSource="{Binding OutputChannels}" ItemTemplate="{StaticResource OutputChannelTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="3" Style="{StaticResource PageSurfaceStyle}" Background="#F8FAFB">
                                    <WrapPanel>
                                        <Ellipse Width="12" Height="12" Fill="LimeGreen" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding L10n[Tool_TestIO_HardwareActive]}" VerticalAlignment="Center" Visibility="{Binding IsSimulationMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        <Ellipse Width="12" Height="12" Fill="Orange" Margin="20,0,5,0"/>
                                        <TextBlock Text="{Binding L10n[Tool_TestIO_SimulationActive]}" VerticalAlignment="Center" Visibility="{Binding IsSimulationMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding RefreshingSummary}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#24557A">
                                            <TextBlock.Visibility>
                                                <Binding Path="IsRefreshing" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </WrapPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{Binding L10n[Sub_entry_Log]}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource PageSurfaceStyle}">
                                <DockPanel>
                                    <TextBlock Text="{Binding L10n[Tool_Log_Title]}" Style="{StaticResource CardTitleStyle}"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="{Binding L10n[Tool_Log_Save]}" Style="{StaticResource LightHeaderActionButtonStyle}" Command="{Binding SaveLogToFileCommand}"/>
                                        <Button Content="{Binding L10n[Tool_Log_Clear]}" Style="{StaticResource LightHeaderActionButtonStyle}" Command="{Binding ClearLogCommand}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource PageSurfaceStyle}">
                                <ListView ItemsSource="{Binding LogEntries}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Width="100" Foreground="Gray"/>
                                                <Rectangle Width="5" Height="15" Fill="{Binding LevelBrush}" Margin="5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Allarmi Scarto sub-tab -->
                    <TabItem Header="Allarmi Scarto">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header toolbar -->
                            <Border Grid.Row="0" Style="{StaticResource PageSurfaceStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Allarmi Scarto" Style="{StaticResource CardTitleStyle}" Margin="0,0,16,0"/>
                                        <Border Background="#1E3A5F" CornerRadius="10" Padding="10,3">
                                            <TextBlock Text="{Binding EjectionAlarmsSummary}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Ricarica" Style="{StaticResource LightHeaderActionButtonStyle}" Command="{Binding ReloadEjectionAlarmsCommand}" Margin="0,0,6,0"/>
                                        <Button Content="Salva" Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding SaveEjectionAlarmsCommand}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Info hint -->
                            <Border Grid.Row="1" Style="{StaticResource PageSurfaceStyle}">
                                <TextBlock Text="Configura il canale di uscita IO e la durata impulso per ciascun allarme scarto. Le modifiche sono attive dopo il salvataggio." Foreground="#697989" TextWrapping="Wrap" FontSize="11"/>
                            </Border>

                            <!-- Alarms DataGrid -->
                            <Border Grid.Row="2" Style="{StaticResource PageSurfaceStyle}">
                                <DataGrid ItemsSource="{Binding EjectionAlarms}"
                                          SelectedItem="{Binding SelectedEjectionAlarm, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0"
                                          Style="{StaticResource MappingDataGridStyle}">
                                    <DataGrid.Columns>

                                        <!-- Status indicator -->
                                        <DataGridTemplateColumn Header="Stato" Width="55" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="12" Height="12" HorizontalAlignment="Center"
                                                             Fill="{Binding IsTriggered, Converter={StaticResource BooleanToColorConverter}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Enabled -->
                                        <DataGridTemplateColumn Header="Abilitato" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Name (readonly) -->
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="160" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- AlarmType -->
                                        <DataGridTemplateColumn Header="Tipo Allarme" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AlarmType}" VerticalAlignment="Center" Margin="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Data.AlarmTypeValues, Source={StaticResource DigitalIoBindingProxy}}"
                                                              SelectedItem="{Binding AlarmType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource DigitalIoComboBoxStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Threshold -->
                                        <DataGridTextColumn Header="Soglia" Binding="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" Width="70">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="4,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- OutputChannelId -->
                                        <DataGridTemplateColumn Header="Canale Output" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                                        <TextBlock Text="{Binding OutputChannelId}" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.MachineOutputs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedValuePath="Channel"
                                                              SelectedValue="{Binding OutputChannelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource DigitalIoComboBoxStyle}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding SignalCode}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="{Binding Channel}" Foreground="#697989"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- PulseDurationMs -->
                                        <DataGridTextColumn Header="Impulso (ms)" Binding="{Binding PulseDurationMs, UpdateSourceTrigger=PropertyChanged}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="4,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- TriggerCount -->
                                        <DataGridTextColumn Header="Conteggio" Binding="{Binding TriggerCount}" Width="80" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="4,0"/>
                                                    <Setter Property="Foreground" Value="#4A5A67"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Bottom action bar -->
                            <Border Grid.Row="3" Style="{StaticResource PageSurfaceStyle}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Reset Selezionato"
                                            Style="{StaticResource LightHeaderActionButtonStyle}"
                                            Command="{Binding ResetSelectedEjectionAlarmCommand}"/>
                                    <TextBlock Text="Selezionare una riga per resettare il flag di triggered e il conteggio." Foreground="#697989" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                        </Grid>
                    </TabItem>

                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>













