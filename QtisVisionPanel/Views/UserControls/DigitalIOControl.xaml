                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardSummaryCardStyle}" Width="322">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L10n[Tool_Encoder_LineThroughput]}" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="{Binding MainEncoderPiecesSummary}" Style="{StaticResource MetricValueStyle}"/>
                                        <TextBlock Text="{Binding L10n[Tool_Encoder_ThroughputHint]}" Margin="0,6,0,0" Foreground="#697989" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardSummaryCardStyle}" Width="322">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L10n[Tool_Encoder_MachineZeroAndPhotocell]}" Style="{StaticResource CardTitleStyle}"/>
