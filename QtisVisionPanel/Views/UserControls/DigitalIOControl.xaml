                                    <TabControl.ItemContainerStyle>
                                        <Style TargetType="TabItem" BasedOn="{StaticResource ToolTabItemStyle}"/>
                                    </TabControl.ItemContainerStyle>
                                    <TabItem Header="{Binding L10n[Tool_Signals_MachineInputs]}">
                                        <DataGrid Style="{StaticResource MappingDataGridStyle}" ItemsSource="{Binding MachineInputs}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
