                                        <TextBlock Text="{Binding L10n[Tool_Encoder_MachineZeroHint]}" Margin="0,6,0,0" Foreground="#697989" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardSummaryCardStyle}" Width="322">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L10n[Tool_Encoder_EventPositions]}" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="{Binding InterventionQuotaSummary}" Style="{StaticResource MetricValueStyle}" FontSize="16"/>
                                        <TextBlock Text="{Binding L10n[Tool_Encoder_EventPositionsHint]}" Margin="0,6,0,0" Foreground="#697989" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L10n[Tool_Encoder_SetupTitle]}" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="{Binding L10n[Tool_Encoder_SetupHint]}" Margin="0,6,0,0" Foreground="#697989" TextWrapping="Wrap"/>

                                    <Expander Header="{Binding L10n[Tool_Encoder_QuickHelp]}" Margin="0,10,0,0" IsExpanded="False">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding L10n[Tool_Encoder_QuickHelp_LineSpeed]}" TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding L10n[Tool_Encoder_QuickHelp_Throughput]}" TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding L10n[Tool_Encoder_QuickHelp_ProductPitch]}" TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding L10n[Tool_Encoder_QuickHelp_ManualStep]}" TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding L10n[Tool_Encoder_QuickHelp_ModeHint]}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Expander>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding L10n[Tool_Encoder_ThroughputDrivenMode]}" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" Grid.ColumnSpan="2" IsChecked="{Binding SimulationUsePiecesPerMinute}" VerticalAlignment="Center" Content="{Binding L10n[Tool_Encoder_UseProductsPerMinute]}"/>

                                        <TextBlock Grid.Row="1" Text="{Binding L10n[Tool_Encoder_LineSpeed]}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SimulationTransportSpeedMetersPerMinute, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding L10n[Tool_Common_MetersPerMinute]}" VerticalAlignment="Center" Margin="8,12,0,0"/>

                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding L10n[Tool_Encoder_ProductionThroughput]}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding SimulationPiecesPerMinute, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding L10n[Tool_Common_PiecesPerMinute]}" VerticalAlignment="Center" Margin="8,12,0,0"/>

                                        <TextBlock Grid.Row="2" Text="{Binding L10n[Tool_Encoder_ProductPitch]}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SimulationProductPitchMm, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding L10n[Tool_Common_Millimeters]}" VerticalAlignment="Center" Margin="8,12,0,0"/>

                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding L10n[Tool_Encoder_ManualStep]}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding SimulationEncoderStepMm, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding L10n[Tool_Common_Millimeters]}" VerticalAlignment="Center" Margin="8,12,0,0"/>

                                        <TextBlock Grid.Row="3" Text="{Binding L10n[Tool_Encoder_PhotocellPosition]}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MainEncoderTemplate.PhotocellMachineOffsetMm, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding L10n[Tool_Common_Millimeters]}" VerticalAlignment="Center" Margin="8,12,0,0"/>

                                    </Grid>

                                    <WrapPanel Margin="0,14,0,0">
