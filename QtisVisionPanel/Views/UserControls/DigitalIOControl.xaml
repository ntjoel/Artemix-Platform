<UserControl x:Class="QtisVisionPanel.Views.UserControls.DigitalIOControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:QtisVisionPanel.Converters" xmlns:local="clr-namespace:QtisVisionPanel.Models" xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:DecimalTextBoxConverter x:Key="DecimalTextBoxConverter"/>
        <local:BindingProxy x:Key="DigitalIoBindingProxy" Data="{Binding}"/>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#C7CED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="PageSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="BorderBrush" Value="#D8E2EC"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PageIntroCardStyle" TargetType="Border" BasedOn="{StaticResource PageSurfaceStyle}">
            <Setter Property="Background" Value="#F3F7FB"/>
            <Setter Property="BorderBrush" Value="#D5E0EB"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#24313F"/>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#18354E"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#18354E"/>
        </Style>

        <Style x:Key="DashboardSummaryCardStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="MinHeight" Value="118"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="SectionActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C8D4DF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SmallActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionActionButtonStyle}">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionActionButtonStyle}">
            <Setter Property="Background" Value="#18354E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#18354E"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="118"/>
        </Style>

        <Style x:Key="LightHeaderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionActionButtonStyle}">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="Foreground" Value="#18354E"/>
            <Setter Property="BorderBrush" Value="#C8D4DF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="118"/>
        </Style>

        <Style x:Key="ConfigFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3F5366"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InlineFormCardStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#F8FBFD"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PageHeaderHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#697989"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SubSectionCardStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="#F8FBFD"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ToolTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ToolTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#31536C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#EAF1F7"/>
            <Setter Property="BorderBrush" Value="#D0DBE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C7D4E2"/>
                                <Setter Property="Foreground" Value="#18354E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F4F8FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DigitalIoComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DigitalIoComboBoxItemStyle}"/>

        <Style x:Key="DigitalIoComboBoxStyle" TargetType="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DigitalIoComboBoxItemStyle}"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource DigitalIoComboBoxStyle}"/>

        <Style x:Key="CompactComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DigitalIoComboBoxStyle}">
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CompactTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InfoBadgeStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#D9E8F3"/>
            <Setter Property="Foreground" Value="#18354E"/>
            <Setter Property="BorderBrush" Value="#9DB6C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Help"/>
        </Style>

        <Style x:Key="ModeSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="82"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="82" Height="30">
                            <Border x:Name="Track" CornerRadius="15" Background="#2F5D7C" BorderBrush="#234761" BorderThickness="1"/>
                            <Border x:Name="Thumb" Width="26" Height="26" CornerRadius="13" Background="White" HorizontalAlignment="Right" Margin="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3B7A57"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#2F6447"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Left"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolCommandBarButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionActionButtonStyle}">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MetricValueStyle_OLD" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#18354E"/>
        </Style>


        <Style x:Key="MappingHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667685"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="SectionBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2,8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="MappingDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="MinColumnWidth" Value="90"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#D5DEE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="AlternatingRowBackground" Value="#F7FAFD"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EEF5"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EDF3F8"/>
        </Style>

        <Style x:Key="MappingColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1F7"/>
            <Setter Property="Foreground" Value="#18354E"/>
            <Setter Property="BorderBrush" Value="#D0DBE6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="MappingCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#24313F"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFA"/>
                    <Setter Property="Foreground" Value="#10253B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MappingHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#24313F"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
        </Style>

        <Style x:Key="MappingRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#24313F"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRuntimeBound}" Value="True">
                    <Setter Property="Background" Value="#E8F6EC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAdditionalBinding}" Value="True">
                    <Setter Property="Background" Value="#E9F1FF"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRuntimeBound}" Value="False"/>
                        <Condition Binding="{Binding IsAdditionalBinding}" Value="False"/>
                        <Condition Binding="{Binding ReservedForRealSignal}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFF6D9"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="InputChannelTemplate">
            <Border Width="142" MinHeight="78" Style="{StaticResource PanelBorderStyle}" Padding="8" Margin="4" BorderBrush="{Binding ActiveBrush}" BorderThickness="2">
                <StackPanel>
                    <DockPanel>
                        <Ellipse Width="12" Height="12" Fill="{Binding IsActive, Converter={StaticResource BooleanToColorConverter}}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding ChannelName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="{Binding State}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OutputChannelTemplate">
            <Border Width="164" MinHeight="112" Style="{StaticResource PanelBorderStyle}" Padding="8" Margin="4" BorderBrush="{Binding ActiveBrush}" BorderThickness="2">
                <StackPanel>
                    <DockPanel>
                        <Ellipse Width="12" Height="12" Fill="{Binding IsActive, Converter={StaticResource BooleanToColorConverter}}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding ChannelName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="{Binding StateText}" Margin="0,8,0,8" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#18354E"/>
                    <ToggleButton Content="{Binding DataContext.L10n[Tool_Action_Toggle], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  IsChecked="{Binding IsActive}"
                                  Command="{Binding DataContext.SetOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding ChannelNumber}"
                                  Padding="10,4"
                                  MinWidth="92"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EncoderChannelTemplate">
            <Border Width="300" MinHeight="220" Style="{StaticResource PanelBorderStyle}" Padding="10" Margin="5">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding ChannelName}" FontWeight="Bold"/>
                        <Border DockPanel.Dock="Right" Background="#EEF3F7" BorderBrush="#D5DEE6" BorderThickness="1" CornerRadius="10" Padding="8,2,8,2">
                            <TextBlock Text="{Binding DiagnosticState}" FontSize="10.5" FontWeight="SemiBold" Foreground="#3B556C"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="{Binding SpeedDisplay}" FontSize="24" FontWeight="Bold" Foreground="#18354E" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                    <TextBlock Text="{Binding PiecesPerMinuteDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="#415463" HorizontalAlignment="Center"/>
                    <UniformGrid Columns="3" Margin="0,12,0,0">
                        <Border Background="#F6F9FC" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.L10n[Tool_Label_Count], RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#697989" FontSize="10.5"/>
                                <TextBlock Text="{Binding CounterValue, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F6F9FC" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.L10n[Tool_Label_Delta], RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#697989" FontSize="10.5"/>
                                <TextBlock Text="{Binding DeltaCountsDisplay}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F6F9FC" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.L10n[Tool_Label_CountsPerMillimeter], RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#697989" FontSize="10.5"/>
                                <TextBlock Text="{Binding CountsPerMillimeterDisplay}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Expander Header="{Binding DataContext.L10n[Sub_entry_EncoderDiagnostics], RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,10,0,0" IsExpanded="False">
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding DataContext.L10n[Tool_Label_RawSpeed], RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#697989" FontSize="10.5"/>
                                <TextBlock Text="{Binding RawSpeedDisplay}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.L10n[Tool_Label_PulseFrequency], RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#697989" FontSize="10.5"/>
                                <TextBlock Text="{Binding PulseFrequencyDisplay}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,8,8,0">
                                <TextBlock Text="{Binding DataContext.L10n[Tool_Label_SamplePeriod], RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#697989" FontSize="10.5"/>
                                <TextBlock Text="{Binding SamplePeriodDisplay}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding DataContext.L10n[Tool_Encoder_CounterStatus], RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#697989" FontSize="10.5"/>
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding DataContext.L10n[Tool_Encoder_DiagnosticsLabel], RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#697989" FontSize="10.5"/>
                                <TextBlock Text="{Binding DiagnosticState}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </UniformGrid>
                    </Expander>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="{Binding DataContext.L10n[Tool_Action_Reset], RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SmallActionButtonStyle}" Command="{Binding DataContext.ResetEncodersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding ChannelNumber}"/>
                        <Button Content="{Binding DataContext.L10n[Tool_Action_Stop], RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SmallActionButtonStyle}" Command="{Binding DataContext.StopEncodersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding ChannelNumber}"/>
                        <Button Content="{Binding DataContext.L10n[Tool_Action_Start], RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SmallActionButtonStyle}" Command="{Binding DataContext.StartEncodersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding ChannelNumber}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MachineOperationalEventTemplate">
            <Border Style="{StaticResource PanelBorderStyle}" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TimeDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="#18354E"/>
                        <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="#697989"/>
                        <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="#697989" TextWrapping="Wrap">
                            <Run Text="{Binding DataContext.L10n[Tool_Events_MainProjectCategoryLabel], RelativeSource={RelativeSource AncestorType=UserControl}}"/><Run Text=" "/><Run Text="{Binding MainProjectCategory, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#24313F"/>
                        <TextBlock Text="{Binding EventCode}" FontSize="10.5" Foreground="#697989"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="10,0,10,0">
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#415463"/>
                        <TextBlock Margin="0,4,0,0" Foreground="#697989" FontSize="10.5" TextWrapping="Wrap">
                            <Run Text="{Binding DataContext.L10n[Tool_Events_ProductLabel], RelativeSource={RelativeSource AncestorType=UserControl}}"/><Run Text=" "/><Run Text="{Binding ProductDisplay, Mode=OneWay}"/>
                            <Run Text=" | "/><Run Text="{Binding DataContext.L10n[Tool_Events_SignalLabel], RelativeSource={RelativeSource AncestorType=UserControl}}"/><Run Text=" "/><Run Text="{Binding SignalCode, Mode=OneWay}"/>
                            <Run Text=" | "/><Run Text="{Binding DataContext.L10n[Tool_Events_PositionLabel], RelativeSource={RelativeSource AncestorType=UserControl}}"/><Run Text=" "/><Run Text="{Binding QuotaDisplay, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="#697989" FontSize="10.5" TextWrapping="Wrap">
                            <Run Text="{Binding DataContext.L10n[Tool_Events_MainProjectStatusLabel], RelativeSource={RelativeSource AncestorType=UserControl}}"/><Run Text=" "/><Run Text="{Binding MainProjectMachineStatus, Mode=OneWay}"/>
                            <Run Text=" | "/><Run Text="{Binding DataContext.L10n[Tool_Events_MainProjectLogLabel], RelativeSource={RelativeSource AncestorType=UserControl}}"/><Run Text=" "/><Run Text="{Binding MainProjectLogId, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EAF3FA" BorderBrush="#C9D8E4" BorderThickness="1" CornerRadius="10" Padding="10,3,10,3">
                        <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" Foreground="#31536C"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F4F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="8,8,8,6"
                Background="#FFFFFF"
                BorderBrush="#D4DDE5"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding L10n[Tool_Mode_Label]}" Foreground="#18354E" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding L10n[Tool_Mode_Hardware]}" VerticalAlignment="Center" Foreground="#234761" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <ToggleButton Style="{StaticResource ModeSwitchStyle}"
                                      IsChecked="{Binding IsSimulationMode, Mode=OneWay}"
                                      Command="{Binding ToggleConnectionModeCommand}"
                                      ToolTip="{Binding L10n[Tool_Mode_Tooltip]}"/>
                        <TextBlock Text="{Binding L10n[Tool_Mode_Simulation]}" VerticalAlignment="Center" Foreground="#2F6447" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="#F7FAFC" BorderBrush="#D4DDE5" BorderThickness="1" CornerRadius="8" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
