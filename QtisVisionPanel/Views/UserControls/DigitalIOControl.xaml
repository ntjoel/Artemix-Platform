                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="{Binding L10n[Tool_Dashboard_CameraTrigger]}"/><Run Text=" "/><Run Text="{Binding BoundCameraTriggerSignalCode}"/></TextBlock>
