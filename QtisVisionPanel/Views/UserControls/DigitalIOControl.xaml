                                    <StackPanel>
                                        <TextBlock Text="{Binding L10n[Tool_Dashboard_ActiveMode]}" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="{Binding ActiveConnectionModeLabel}" Style="{StaticResource MetricValueStyle}" FontSize="20"/>
                                        <TextBlock Text="{Binding MachineControllerStatus}" Margin="0,6,0,0" Foreground="#697989" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardSummaryCardStyle}" Width="322">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L10n[Tool_Dashboard_LiveInputs]}" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="{Binding ActiveInputsSummary}" Style="{StaticResource MetricValueStyle}" FontSize="22"/>
                                        <TextBlock Text="{Binding L10n[Tool_Dashboard_LiveInputsHint]}" Margin="0,6,0,0" Foreground="#697989" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardSummaryCardStyle}" Width="322">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L10n[Tool_Dashboard_LiveOutputs]}" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="{Binding ActiveOutputsSummary}" Style="{StaticResource MetricValueStyle}" FontSize="22"/>
                                        <TextBlock Text="{Binding L10n[Tool_Dashboard_LiveOutputsHint]}" Margin="0,6,0,0" Foreground="#697989" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardSummaryCardStyle}" Width="322">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L10n[Tool_Dashboard_MachineConfiguration]}" Style="{StaticResource CardTitleStyle}"/>
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock Text="{Binding L10n[Tool_Dashboard_Ready]}" Style="{StaticResource MetricValueStyle}"/>
