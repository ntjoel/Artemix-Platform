                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L10n[Tool_Dashboard_MachineOverview]}" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="{Binding ConnectionCheckDetails}" Margin="0,6,0,0" Foreground="#697989" TextWrapping="Wrap"/>

                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding L10n[Sub_entry_TriggerMode]}" Foreground="#697989" FontSize="11"/>
                                            <TextBlock Text="{Binding MachineTriggerMode}" FontWeight="SemiBold" FontSize="16"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding L10n[Sub_entry_RejectMode]}" Foreground="#697989" FontSize="11"/>
                                            <TextBlock Text="{Binding MachineRejectMode}" FontWeight="SemiBold" FontSize="16"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <UniformGrid Columns="2" Margin="0,10,0,0">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding L10n[Tool_Dashboard_Heartbeat]}" Foreground="#697989" FontSize="11"/>
                                            <TextBlock Text="{Binding HeartbeatDashboardSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding L10n[Tool_Dashboard_ProductTracking]}" Foreground="#697989" FontSize="11"/>
                                            <TextBlock Text="{Binding TrackedProductsSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <Border Background="#F6F9FC" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding L10n[Tool_Dashboard_LatestRuntimeState]}" FontWeight="SemiBold" Foreground="#18354E"/>
                                            <TextBlock Text="{Binding LastTrackedProductStatus}" Margin="0,6,0,0" Foreground="#4A5A67" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LastConfigurationSaveSummary}" Margin="0,6,0,0" Foreground="#4A5A67" TextWrapping="Wrap"/>
                                        </StackPanel>
