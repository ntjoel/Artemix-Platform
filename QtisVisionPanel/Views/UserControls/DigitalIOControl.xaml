                                        <TextBlock Text="{Binding L10n[Tool_Encoder_LineCompact]}" Foreground="#697989" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MainEncoderSpeedSummary}" FontSize="22" FontWeight="Bold" Foreground="#18354E" VerticalAlignment="Center"/>
                                        <TextBlock Text="   " />
                                        <TextBlock Text="{Binding MainEncoderPiecesSummary}" FontSize="18" FontWeight="SemiBold" Foreground="#415463" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding L10n[Tool_Encoder_LiveChannelsHint]}" Foreground="#697989" Margin="0,0,0,10" TextWrapping="Wrap"/>
