                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="{Binding L10n[Tool_Dashboard_Alarm]}"/><Run Text=" "/><Run Text="{Binding BoundGeneralAlarmSignalCode}"/></TextBlock>
