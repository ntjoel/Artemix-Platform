<UserControl x:Class="QtisVisionPanel.Views.UserControls.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:QtisVisionPanel.Converters"
             mc:Ignorable="d"
             Height="Auto"
             Width="Auto">
    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:CollectionCountConverter x:Key="CollectionCountConverter"/>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
        <converters:DoubleLessThanConverter x:Key="DoubleLessThanConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:PercentageToWidthConverter x:Key="PercentageToWidthConverter"/>
        <converters:MultiPercentageToWidthConverter x:Key="MultiPercentageToWidthConverter"/>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#D6E1EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFDFF"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#10253B"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="FontSize" Value="14"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6A7F95"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="FontSize" Value="10"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#173755"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D5C83"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#1F6FA7"/>
            <Setter Property="BorderBrush" Value="#2F84C2"/>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#EEF3F8"/>
            <Setter Property="BorderBrush" Value="#D6E1EB"/>
            <Setter Property="Foreground" Value="#13304A"/>
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#1F6FA7"/>
            <Setter Property="BorderBrush" Value="#2F84C2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="Width" Value="32"/>
                    <Setter Property="Height" Value="32"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="FontSize" Value="13"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CounterValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#10253B"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="FontSize" Value="20"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CounterCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6A7F95"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="CounterCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#F7FAFE"/>
            <Setter Property="BorderBrush" Value="#DCE6F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DefectIconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelHeaderBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="Padding" Value="12,8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelBodyGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="14,14,14,12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="Margin" Value="10,10,10,8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DefectItemCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#F8FBFE"/>
            <Setter Property="BorderBrush" Value="#DCE6F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Padding" Value="10,8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DefectIconContainerStyle" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE6F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="Width" Value="36"/>
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DefectLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#10253B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="FontSize" Value="12"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DefectErrorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D34141"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="FontSize" Value="10"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DefectValueBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#EAF2FB"/>
            <Setter Property="BorderBrush" Value="#BFD7EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="56"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="MinWidth" Value="50"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DefectsScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Padding" Value="14,14,14,8"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="Padding" Value="10,10,10,6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F8FB"/>
            <Setter Property="BorderBrush" Value="#D6E1EB"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource DoubleLessThanConverter}, ConverterParameter=900}"
                             Value="True">
                    <Setter Property="Padding" Value="12,8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="SelectionCounterTemplate">
            <Border Style="{StaticResource CounterCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Header}"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="14"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,4,0,10"
                               Text="{Binding Description}"
                               Style="{StaticResource CounterCaptionStyle}"
                               FontSize="9"
                               LineHeight="12"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2"
                               Text="{Binding DisplayValue}"
                               Style="{StaticResource CounterValueStyle}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DefectItemTemplate">
            <Border Style="{StaticResource DefectItemCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DefectIconContainerStyle}">
                        <Image Source="{Binding IconPath, Converter={StaticResource ImagePathConverter}}"
                               Style="{StaticResource DefectIconImageStyle}"
                               ToolTip="{Binding ToolTip}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding Feature}"
                                   Style="{StaticResource DefectLabelStyle}"/>
                        <TextBlock Text="{Binding LastErrorMessage}"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource DefectErrorStyle}"
                                   Visibility="{Binding LastErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource DefectValueBadgeStyle}">
                        <TextBlock Text="{Binding DisplayValue}"
                                   Foreground="#1B4F7A"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelCardStyle}"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#EEF3F8"
                            BorderBrush="#D6E1EB"
                            BorderThickness="0,0,0,1"
                            CornerRadius="16,16,0,0"
                            Style="{StaticResource PanelHeaderBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="Sub_entry_SelectionCounters_Header"
                                       Text="SELECTION COUNTERS"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="Sub_entry_SelectionCounters_Hint"
                                       Text="Totali produzione e andamento qualità"
                                       Style="{StaticResource SectionHintStyle}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Style="{StaticResource PanelBodyGridStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0"
                                      ItemsSource="{Binding InspectionData.SelectionCounters}"
                                      ItemTemplate="{StaticResource SelectionCounterTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <Border Grid.Row="2"
                                Background="#EAF4FF"
                                BorderBrush="#BFD7EA"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           x:Name="Sub_entry_QualityIndex"
                                           Text="Indice di Qualità Produzione"
                                           HorizontalAlignment="Center"
                                           Foreground="#0E4270"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,0,6"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ProgressContainer"
                                            Grid.Column="0"
                                            Background="#DDE4EC"
                                            Height="22"
                                            CornerRadius="11"
                                            Margin="0,0,10,0">
                                        <Border x:Name="ProgressBar"
                                                CornerRadius="11"
                                                HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource MultiPercentageToWidthConverter}">
                                                    <Binding Path="DataContext.QualityPercentage"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding ElementName="ProgressContainer" Path="ActualWidth"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <Border.Background>
                                                <Binding Path="DataContext.QualityPercentageColor"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}"
                                                         Converter="{StaticResource ColorToBrushConverter}"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding DataContext.QualityPercentage,
                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                     StringFormat={}{0}%}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding DataContext.QualityPercentage,
                                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                                 StringFormat={}{0:F2}%}"
                                                   Foreground="#0E4270"
                                                   FontWeight="Bold"
                                                   FontSize="16"/>
                                        <TextBlock x:Name="Sub_entry_GoodTotalLabel"
                                                   Text=" (Good/Total)"
                                                   Foreground="#6A7F95"
                                                   FontSize="10"
                                                   Margin="5,0,0,2"
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelCardStyle}"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#EEF3F8"
                            BorderBrush="#D6E1EB"
                            BorderThickness="0,0,0,1"
                            CornerRadius="16,16,0,0"
                            Style="{StaticResource PanelHeaderBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="Sub_entry_DefectsCounters_Header"
                                           Text="DEFECTS COUNTERS"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock x:Name="Sub_entry_DefectsCounters_Hint"
                                           Text="Icona, ispezione, motivo di scarto e contatore"
                                           Style="{StaticResource SectionHintStyle}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="Sub_entry_btn_ToggleDisplayMode"
                                        Command="{Binding ToggleCounterDisplayModeCommand}"
                                        Content="{Binding CounterDisplayModeLabel}"
                                        ToolTip="{Binding CounterDisplayModeToolTip}"
                                        Style="{StaticResource HeaderIconButtonStyle}"/>
                                <Button x:Name="Sub_entry_btn_Reset"
                                        Command="{Binding ResetCountersCommand}"
                                        Content="↺"
                                        ToolTip="Resetta tutti i contatori"
                                        Background="#D94B4B"
                                        BorderBrush="#D94B4B"
                                        Foreground="White"
                                        Style="{StaticResource HeaderIconButtonStyle}"
                                        Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource DefectsScrollViewerStyle}">
                        <ItemsControl ItemsSource="{Binding VisibleDefectCounters}"
                                      ItemTemplate="{StaticResource DefectItemTemplate}"/>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Style="{StaticResource FooterBarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       x:Name="Sub_entry_TotalDefects_Label"
                                       Text="Total Defects"
                                       Foreground="#31485F"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>

                            <Border Grid.Column="1"
                                    Background="#EAF2FB"
                                    BorderBrush="#BFD7EA"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="10,4"
                                    MinWidth="44">
                                <TextBlock Text="{Binding TotalDefectsDisplayValue}"
                                           Foreground="#1B4F7A"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
