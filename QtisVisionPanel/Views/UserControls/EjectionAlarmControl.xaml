<UserControl x:Class="QtisVisionPanel.Views.UserControls.EjectionAlarmControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:QtisVisionPanel.Converters"
             mc:Ignorable="d" 
            d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>
        <!-- Converters -->
        <converters:AlarmTypeToDescriptionConverter x:Key="AlarmTypeToDescriptionConverter"/>
        <converters:AlarmTypeToThresholdLabelConverter x:Key="AlarmTypeToThresholdLabelConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolToEnabledTextConverter x:Key="BoolToEnabledTextConverter"/>

        <!-- Converter per background trigger -->
        <converters:BoolToBrushConverter x:Key="BoolToTriggerBackgroundConverter" 
                                          TrueBrush="#E05353" 
                                          FalseBrush="Transparent"/>
        <converters:BoolToBrushConverter x:Key="BoolToStatusBackgroundConverter"
                                         TrueBrush="#EAF7EE"
                                         FalseBrush="#FDEEEE"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>

        <!-- Stile Card -->
        <Style x:Key="AlarmCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D7E3EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14"
                                      ShadowDepth="0"
                                      Color="#10253B"
                                      Opacity="0.10"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTriggered}" Value="True">
                    <Setter Property="BorderBrush" Value="#E05353"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stile Header Card -->
        <Style x:Key="CardHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#132C45"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="CornerRadius" Value="18,18,0,0"/>
        </Style>

        <!-- Stile Box Descrizione -->
        <Style x:Key="DescriptionBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#EEF6FF"/>
            <Setter Property="BorderBrush" Value="#C9DDF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="16,14,16,10"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- Stile Label Campi -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#60768E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="104"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="FieldValueContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FBFE"/>
            <Setter Property="BorderBrush" Value="#D7E3EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Stile TextBox -->
        <Style x:Key="AlarmTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C9D6E3"/>
            <Setter Property="Background" Value="#FCFDFE"/>
        </Style>

        <!-- Stile ComboBox -->
        <Style x:Key="AlarmComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C9D6E3"/>
            <Setter Property="Background" Value="#FCFDFE"/>
        </Style>

        <!-- Stile Pulsanti Admin -->
        <Style x:Key="AdminButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F5F8FC"/>
            <Setter Property="BorderBrush" Value="#D7E3EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="3000"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#21486A"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="FieldRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="GlyphIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <!-- Template Card Allarme -->
        <DataTemplate x:Key="AlarmCardTemplate">
            <Border Style="{StaticResource AlarmCardStyle}" MouseLeftButtonDown="AlarmCard_MouseLeftButtonDown" Tag="{Binding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;"
                                               Width="16"
                                               Margin="0,0,8,0"
                                               Foreground="#D8E7F5"
                                               Style="{StaticResource GlyphIconStyle}"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="&#xE814;"
                                               Width="16"
                                               Margin="8,0,0,0"
                                               Foreground="#FF8A80"
                                               Visibility="{Binding IsTriggered, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Style="{StaticResource GlyphIconStyle}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding AlarmType, Converter={StaticResource AlarmTypeToDescriptionConverter}}"
                                           Margin="26,4,0,0"
                                           FontSize="11"
                                           Foreground="#BFD3EA"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <Border Style="{StaticResource HeaderBadgeStyle}">
                                    <TextBlock Text="{Binding AlarmType, Converter={StaticResource AlarmTypeToThresholdLabelConverter}}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Descrizione -->
                    <Border Grid.Row="1" Style="{StaticResource DescriptionBoxStyle}">
                        <TextBlock Text="{Binding AlarmType, Converter={StaticResource AlarmTypeToDescriptionConverter}}"
                                   FontSize="11.5"
                                   Foreground="#2C5E89"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Campi Configurazione -->
                    <Grid Grid.Row="2" Margin="16,0,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Abilitato con Icona Power -->
                        <Grid Grid.Row="0" Style="{StaticResource FieldRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Abilitato" Style="{StaticResource FieldLabelStyle}"/>

                            <!-- Toggle Button con Icona Power -->
                            <ToggleButton Grid.Column="1" 
                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                  Width="32" Height="32"
                  Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid>
                                                        <TextBlock x:Name="PowerIcon"
                                                                   Text="&#xE7E8;"
                                                                   Width="20"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#F44336"
                                                                   Style="{StaticResource GlyphIconStyle}"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="PowerIcon" Property="Foreground" Value="#4CAF50"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                            </ToggleButton.Style>
                            </ToggleButton>

                            <Border Grid.Column="2"
                                    Margin="10,0,0,0"
                                    Padding="10,5"
                                    CornerRadius="999"
                                    Background="{Binding Enabled, Converter={StaticResource BoolToStatusBackgroundConverter}}">
                                <TextBlock Text="{Binding Enabled, Converter={StaticResource BoolToEnabledTextConverter}}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Enabled, Converter={StaticResource BoolToColorConverter}}"/>
                            </Border>
                        </Grid>
                        <!-- Tipo Allarme (solo lettura) -->
                        <Grid Grid.Row="1" Style="{StaticResource FieldRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tipo" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Grid.Column="1" Style="{StaticResource FieldValueContainerStyle}">
                                <TextBlock Text="{Binding AlarmType, Converter={StaticResource AlarmTypeToDescriptionConverter}}"
                                           VerticalAlignment="Center"
                                           Foreground="#18324B"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Grid>


                        <!-- Soglia -->
                        <Grid Grid.Row="2" Style="{StaticResource FieldRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Soglia" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" 
                             Text="{Binding Threshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                             IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             Style="{StaticResource AlarmTextBoxStyle}"/>
                        </Grid>

                        <!-- Dimensione Buffer (solo Percentage) -->
                        <Grid Grid.Row="3">
                            <Grid.Style>
                                <Style TargetType="Grid" BasedOn="{StaticResource FieldRowStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AlarmType}" Value="PercentageInBuffer">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dim. Buffer" Style="{StaticResource FieldLabelStyle}" Width="90"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding BufferSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     Style="{StaticResource AlarmTextBoxStyle}"/>
                        </Grid>
                        <!-- NUOVO: Canale Output Fisico -->
                        <Grid Grid.Row="4" Style="{StaticResource FieldRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Uscita Fisica" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableOutputSignals, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              SelectedValuePath="Channel"
                              SelectedValue="{Binding OutputChannelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding DataContext.IsAdministrator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              Style="{StaticResource AlarmComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SignalCode}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Channel}" Foreground="#697989"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <!-- NUOVO: Durata Impulso (0 = Continuo) -->
                        <Grid Grid.Row="5" Style="{StaticResource FieldRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Durata [ms]" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" 
                             Text="{Binding PulseDurationMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue='0'}" 
                             IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             Style="{StaticResource AlarmTextBoxStyle}"/>
                            <TextBlock Grid.Column="1" 
                               Text="(0 = continuo)" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Right"
                               Foreground="Gray" 
                               FontSize="10"
                               Margin="0,0,5,0"/>
                        </Grid>

                        <!-- Difetti Monitorati (Espandibile) -->
                        <Grid Grid.Row="6" Style="{StaticResource FieldRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Difetti" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>

                            <Border Grid.Column="1"
                                    Style="{StaticResource FieldValueContainerStyle}">
                                <Expander Header="Seleziona difetti da monitorare" IsExpanded="False">
                                    <ListBox ItemsSource="{Binding SelectableDefects}"
                                             SelectionMode="Multiple"
                                             IsEnabled="{Binding DataContext.IsAdministrator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             Margin="0,5,0,0"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DisplayName}" 
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </Border>
                        </Grid>





                    </Grid>

                    <!-- Footer con stato trigger -->
                    <Border Grid.Row="3" 
                            Background="{Binding IsTriggered, Converter={StaticResource BoolToTriggerBackgroundConverter}}"
                            Padding="14,9"
                            CornerRadius="0,0,18,18"
                            Visibility="{Binding IsTriggered, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE814;"
                                       Width="14"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource GlyphIconStyle}"/>
                            <TextBlock Text="ALLARME ATTIVO" 
                                       Foreground="White"
                                       FontWeight="Bold"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LastTriggered, StringFormat=' - {0:HH:mm:ss}'}" 
                                       Foreground="White"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
       

    </UserControl.Resources>

    <Grid Background="#F4F8FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="#132C45"
                Padding="18,14"
                BorderBrush="#D7E3EF"
                BorderThickness="0,0,0,1"
                CornerRadius="18,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titolo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#xE7F4;"
                               Width="20"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="#DCE7F5"
                               Style="{StaticResource GlyphIconStyle}"/>
                    <TextBlock Text="Allarmi di Sistema" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center" 
                               Foreground="White"/>
                    <Border Background="#21486A"
                            CornerRadius="999"
                            Padding="10,4"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Alarms.Count, StringFormat='{}{0} allarmi'}" 
                                   FontSize="12" 
                                   Foreground="#E6F0FA"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Pulsanti Admin -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            Visibility="{Binding AdminButtonsVisibility}">
                    <Button x:Name="AddAlarmButton"
        Style="{StaticResource AdminButtonStyle}"
        ToolTip="Aggiungi allarme"
        Click="AddAlarmButton_Click">
                        <TextBlock Text="&#xE710;" Foreground="#4CAF50" Style="{StaticResource GlyphIconStyle}" FontSize="18"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AddAlarmContextMenu">
                                <MenuItem Header="Allarme N (Consecutivi)" 
                      Command="{Binding AddAlarmNCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="N" Foreground="#2196F3" FontWeight="Bold"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Allarme M (Consecutivi Alt)" 
                      Command="{Binding AddAlarmMCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="M" Foreground="#FF9800" FontWeight="Bold"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Allarme % (Percentuale)" 
                      Command="{Binding AddAlarmPercentCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="%" Foreground="#9C27B0" FontWeight="Bold"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Style="{StaticResource AdminButtonStyle}"
                            Command="{Binding RemoveAlarmCommand}"
                            ToolTip="Elimina allarme">
                        <TextBlock Text="&#xE74D;" Foreground="#F44336" Style="{StaticResource GlyphIconStyle}" FontSize="18"/>
                    </Button>

                    <Button Style="{StaticResource AdminButtonStyle}"
                            Command="{Binding DuplicateAlarmCommand}"
                            ToolTip="Duplica allarme">
                        <TextBlock Text="&#xE8C8;" Foreground="#FF9800" Style="{StaticResource GlyphIconStyle}" FontSize="18"/>
                    </Button>

                    <Border Width="1"
                            Height="28"
                            Background="#30506F"
                            Margin="6,0,12,0"/>

                    <Button Style="{StaticResource AdminButtonStyle}"
                            Command="{Binding SaveCommand}"
                            ToolTip="Salva configurazione">
                        <TextBlock Text="&#xE74E;" Foreground="#2196F3" Style="{StaticResource GlyphIconStyle}" FontSize="18"/>
                    </Button>

                    <Button Style="{StaticResource AdminButtonStyle}"
                            Command="{Binding ResetAllCommand}"
                            ToolTip="Resetta tutti">
                        <TextBlock Text="&#xE777;" Foreground="#757575" Style="{StaticResource GlyphIconStyle}" FontSize="18"/>
                    </Button>

                    <Button Style="{StaticResource AdminButtonStyle}"
                            Command="{Binding TestAlarmCommand}"
                            ToolTip="Test allarme">
                        <TextBlock Text="&#xE768;" Foreground="#9C27B0" Style="{StaticResource GlyphIconStyle}" FontSize="18"/>
                    </Button>

                    <Button Style="{StaticResource AdminButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Aggiorna">
                        <TextBlock Text="&#xE72C;" Foreground="#607D8B" Style="{StaticResource GlyphIconStyle}" FontSize="18"/>
                    </Button>
                 
                </StackPanel>
            </Grid>
        </Border>

        <!-- Griglia Card -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="6">
            <ItemsControl ItemsSource="{Binding Alarms}" 
                          ItemTemplate="{StaticResource AlarmCardTemplate}"
                          Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                Padding="16,12"
                BorderBrush="#D7E3EF"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,18,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           FontSize="12" 
                           Foreground="#54708A" 
                           FontStyle="Italic"/>

                <!-- Loading Indicator -->
                <ProgressBar Grid.Column="1" 
                             IsIndeterminate="True" 
                             Width="100" 
                             Height="4"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
