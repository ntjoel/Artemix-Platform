                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Top:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Name="Sub_entry_Top"/>
                                <TextBox Grid.Column="1" Text="{Binding CurrentRecipeData.recipeParamTop.TopValueToLogo, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                <TextBlock Grid.Column="2" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Left:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Name="Sub_entry_Left"/>
                                <TextBox Grid.Column="1" Text="{Binding CurrentRecipeData.recipeParamTop.LeftValueToLogo, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                <TextBlock Grid.Column="2" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Right:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Name="Sub_entry_Right"/>
                                <TextBox Grid.Column="1" Text="{Binding CurrentRecipeData.recipeParamTop.RigthValueToLogo, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                <TextBlock Grid.Column="2" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bottom:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Name="Sub_entry_bottom"/>
                                <TextBox Grid.Column="1" Text="{Binding CurrentRecipeData.recipeParamTop.BottomValueToLogo, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                <TextBlock Grid.Column="2" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Tolleranza centratura -->
                            <Grid Grid.Row="4" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tolleranza:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Name="Sub_entry_Toll_printcenterint"/>
                                <TextBox Grid.Column="1" Text="{Binding CurrentRecipeData.recipeParamTop.Print_centering_Toll, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                <TextBlock Grid.Column="2" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <!-- SOGLIE ISPEZIONI TOP (aggiornate per Packs) -->
                    <GroupBox Grid.Row="4" Header="Soglie Ispezioni TOP"  Name="Sub_entry_Top_Inspection_Thresholds"
         Visibility="{Binding MachineType, Converter={StaticResource MachineTypeToVisibilityConverter}, ConverterParameter=Packs}"
         Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Viste che applicano queste tolleranze, dalla matrice di
                                 Inspection Configuration. La tolleranza resta un valore unico
                                 di ricetta: qui si dichiara solo da quali camere viene usata. -->
                            <TextBlock Text="{Binding TopThresholdsViewLabel}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#5C7A99"
                                       Margin="0,0,0,6"/>
                            <!-- Logo -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,5,0,5"
                Opacity="{Binding CurrentRecipeData.inspectionStatus.logo, Converter={StaticResource BooleanToOpacityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Logo:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Name="Sub_entry_Logo"/>
                                    <TextBox Grid.Column="1" 
                         Text="{Binding CurrentRecipeData.recipeParamTop.LogoToll, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                    <TextBlock Grid.Column="2" Text="%" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" 
                           Text="{Binding CurrentRecipeData.recipeParamTop.LogoToll, StringFormat='≥{0:0.00}'}" 
                           Foreground="#666666" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                           

                            <!-- Open Flaps -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,5,0,5"
                Opacity="{Binding CurrentRecipeData.inspectionStatus.OpenFlaps, Converter={StaticResource BooleanToOpacityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Area max. alette aperte:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Name="Sub_entry_Flaps"/>
                                    <TextBox Grid.Column="1" 
                         Text="{Binding CurrentRecipeData.recipeParamTop.MinAreaOpenFlas, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                    <TextBlock Grid.Column="2" Text="mm²" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" 
                           Text="{Binding CurrentRecipeData.recipeParamTop.MinAreaOpenFlas, StringFormat='≤{0:0.00}'}"
                           Foreground="#666666" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Shape -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,5,0,5"
                Opacity="{Binding CurrentRecipeData.inspectionStatus.ShapeTop, Converter={StaticResource BooleanToOpacityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Forma Nominale:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Name="Sub_entry_ShapeValue"/>
                                    <TextBox Grid.Column="1" 
                         Text="{Binding CurrentRecipeData.recipeParamTop.ShapeValue, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                    <TextBlock Grid.Column="2" Text="°" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" 
                           Text="{Binding CurrentRecipeData.recipeParamTop.ShapeToll, StringFormat='±{0:0.00}'}" 
                           Foreground="#666666" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Shape Tolerance -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,5,0,5"
                Opacity="{Binding CurrentRecipeData.inspectionStatus.ShapeTop, Converter={StaticResource BooleanToOpacityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Toll. Forma:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Name="Sub_entry_Toll_shape"/>
                                    <TextBox Grid.Column="1" 
                         Text="{Binding CurrentRecipeData.recipeParamTop.ShapeToll, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                    <TextBlock Grid.Column="2" Text="" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" 
                           Text="{Binding CurrentRecipeData.recipeParamTop.ShapeToll, StringFormat='±{0:0.00}'}" 
                           Foreground="#666666" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- SOGLIE ISPEZIONI SIDE (aggiornate per Packs) -->
                    <GroupBox Grid.Row="5" Header="Soglie Ispezioni SIDE" Name="Sub_entry_Side_Inspection_Thresholds"
         Visibility="{Binding CanShowSideInspectionThresholds, Converter={StaticResource BoolToVisibility}}"
         Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SideThresholdsViewLabel}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#5C7A99"
                                       Margin="0,0,0,6"/>
                            <!-- Sealing -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,5,0,5"
                Opacity="{Binding CurrentRecipeData.inspectionStatus.Side_sealing, Converter={StaticResource BooleanToOpacityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Sigillatura:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Name="Sub_entry_Sealing"/>
                                    <TextBox Grid.Column="1" 
                         Text="{Binding CurrentRecipeData.recipeParamSide.MinAreaSealing, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                    <TextBlock Grid.Column="2" Text="mm²" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                           Text="{Binding CurrentRecipeData.recipeParamSide.MinAreaSealing, StringFormat='≥{0:0.00}'}"
                           Foreground="#666666" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Soglie di sigillatura specifiche per vista. Prima esisteva un
                                 unico scalare condiviso fra SIDE e REAR, nonostante ottica,
                                 distanza e inquadratura diverse. Zero = eredita la soglia SIDE
                                 qui sopra, quindi le ricette esistenti non cambiano. -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,5,0,5"
                Opacity="{Binding CurrentRecipeData.inspectionStatus.Side_sealing, Converter={StaticResource BooleanToOpacityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Sigillatura REAR:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                         Text="{Binding CurrentRecipeData.recipeParamSide.MinAreaSealingRear, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                    <TextBlock Grid.Column="2" Text="mm²" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="0 = usa SIDE"
                           Foreground="#666666" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Margin="0,3" Padding="5" Visibility="{Binding HasRightCameraConfigured, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Sigillatura RIGHT:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding CurrentRecipeData.recipeParamSide.MinAreaSealingRight, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                    <TextBlock Grid.Column="2" Text="mm²" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,5,0,5"
                Opacity="{Binding CurrentRecipeData.inspectionStatus.Side_sealing, Converter={StaticResource BooleanToOpacityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Sigillatura LEFT:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                         Text="{Binding CurrentRecipeData.recipeParamSide.MinAreaSealingLeft, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTolerances}"/>
                                    <TextBlock Grid.Column="2" Text="mm²" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="0 = usa SIDE"
                           Foreground="#666666" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    <!-- TRIGGER DELAY CONFIGURATION (solo per utenti Expert) -->
                    <!-- ATTENZIONE: questo GroupBox non contiene solo i trigger delay. Si chiude
                         a riga ~1859 e racchiude anche le correzioni runtime per ricetta:
                         modalita' trigger camera, offset posizione camera e parametri MultiShot.
                         La sua Visibility deve quindi restare quella di ruolo. La condizione
                         CanShowTriggerDelaySection va applicata SOLO al blocco dei ritardi. -->
                    <GroupBox Grid.Row="6" Header="Configurazione Trigger" Name="Sub_entry_Trigger_Config"
          Visibility="{Binding CanEditTriggerDelay, Converter={StaticResource BoolToVisibility}}"
          Margin="0,0,0,10">
                        <StackPanel>
                        <StackPanel x:Name="Sub_entry_TriggerDelayFields"
                                    Visibility="{Binding CanShowTriggerDelaySection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Trigger Delay Top:" FontWeight="Bold" Margin="0,5" x:Name="Sub_entry_TopTriggerDelayLabel"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                     Text="{Binding CurrentRecipeData.cameraSetting.TopCameraTriggerDelay, StringFormat='{}{0:0}', UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="TextBox_TextChanged" 
                     IsEnabled="{Binding CanEditTriggerDelay}"/>
                                <TextBlock Grid.Column="1" Text="μs" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Visibility="{Binding HasLeftCameraConfigured, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Trigger Delay Left:" FontWeight="Bold" Margin="0,5" x:Name="Sub_entry_SideTriggerDelayLabel"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                     Text="{Binding LeftCameraHardwareDelayUs, StringFormat='{}{0:0}', UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="TextBox_TextChanged" 
                     IsEnabled="{Binding CanEditTriggerDelay}"/>
                                    <TextBlock Grid.Column="1" Text="μs" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasRightCameraConfigured, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Trigger Delay Right:" FontWeight="Bold" Margin="0,5" x:Name="Sub_entry_RightTriggerDelayLabel"/>
                                <TextBox Text="{Binding CurrentRecipeData.cameraSetting.RightCameraTriggerDelay, StringFormat='{}{0:0}', UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTriggerDelay}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasRearCameraConfigured, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Trigger Delay Rear:" FontWeight="Bold" Margin="0,5"/>
                                <TextBox Text="{Binding CurrentRecipeData.cameraSetting.RearCameraTriggerDelay, StringFormat='{}{0:0}', UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTriggerDelay}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasBottomCameraConfigured, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Trigger Delay Bottom:" FontWeight="Bold" Margin="0,5" x:Name="Sub_entry_BottomTriggerDelayLabel"/>
                                <TextBox Text="{Binding CurrentRecipeData.cameraSetting.BottomCameraTriggerDelay, StringFormat='{}{0:0}', UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TextBox_TextChanged" IsEnabled="{Binding CanEditTriggerDelay}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasFrontCameraConfigured, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Trigger Delay Front:" FontWeight="Bold" Margin="0,5" x:Name="Sub_entry_FrontTriggerDelayLabel"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                     Text="{Binding CurrentRecipeData.cameraSetting.FrontCameraTriggerDelay, StringFormat='{}{0:0}', UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="TextBox_TextChanged" 
                     IsEnabled="{Binding CanEditTriggerDelay}"/>
                                    <TextBlock Grid.Column="1" Text="μs" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="Nota: Valori in microsecondi. Modifiche applicate al salvataggio." x:Name="Sub_entry_TriggerDelayNote"
                   FontSize="9" FontStyle="Italic" Foreground="#666666" TextWrapping="Wrap"/>
                        </StackPanel>

                            <Separator Margin="0,14,0,12"/>
                            <Expander x:Name="Sub_entry_RecipeCameraTriggersExpander" Header="Camera triggers for this recipe" IsExpanded="True" Margin="0,0,0,12">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock x:Name="Sub_entry_RecipeCameraTriggersHint" Text="The board, channel and polarity remain global. Select only whether each camera trigger inherits, is enabled, or is disabled for this product."
                                               FontSize="9" Foreground="#4B6178" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Grid Visibility="{Binding HasTopCameraConfigured, Converter={StaticResource BoolToVisibility}}" Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Sub_entry_RecipeTopTriggerModeLabel" Text="TOP trigger" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecipeMultiShotModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding CurrentRecipeData.machineRuntimeAdjustments.CameraTriggers.Top, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DropDownClosed="RecipeMultiShotMode_DropDownClosed" IsEnabled="{Binding CanEditTriggerDelay}"/>
                                    </Grid>
                                    <Grid Visibility="{Binding HasLeftCameraConfigured, Converter={StaticResource BoolToVisibility}}" Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Sub_entry_RecipeLeftTriggerModeLabel" Text="{Binding LeftCameraTriggerLabel}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecipeMultiShotModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding LeftCameraTriggerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DropDownClosed="RecipeMultiShotMode_DropDownClosed" IsEnabled="{Binding CanEditTriggerDelay}"/>
                                    </Grid>
                                    <Grid Visibility="{Binding HasFrontCameraConfigured, Converter={StaticResource BoolToVisibility}}" Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Sub_entry_RecipeFrontTriggerModeLabel" Text="FRONT trigger" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecipeMultiShotModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding CurrentRecipeData.machineRuntimeAdjustments.CameraTriggers.Front, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DropDownClosed="RecipeMultiShotMode_DropDownClosed" IsEnabled="{Binding CanEditTriggerDelay}"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Sub_entry_RecipeRightTriggerModeLabel" Text="RIGHT trigger" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecipeMultiShotModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding RightCameraTriggerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DropDownClosed="RecipeMultiShotMode_DropDownClosed" IsEnabled="{Binding HasRightCameraConfigured}"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="REAR trigger" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecipeMultiShotModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding RearCameraTriggerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DropDownClosed="RecipeMultiShotMode_DropDownClosed" IsEnabled="{Binding HasRearCameraConfigured}"/>
                                    </Grid>
                                    <Grid Visibility="{Binding HasBottomCameraConfigured, Converter={StaticResource BoolToVisibility}}" Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Sub_entry_RecipeBottomTriggerModeLabel" Text="BOTTOM trigger" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecipeMultiShotModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding CurrentRecipeData.machineRuntimeAdjustments.CameraTriggers.Bottom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DropDownClosed="RecipeMultiShotMode_DropDownClosed" IsEnabled="{Binding CanEditTriggerDelay}"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                            <TextBlock x:Name="Sub_entry_RecipeRuntimeCorrectionsTitle"
                                       Text="Correzioni posizione camera per ricetta"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="Sub_entry_RecipeRuntimeCorrectionsHint"
                                       Text="La quota base resta globale nel setup macchina. Inserire qui solo la correzione positiva o negativa richiesta dal prodotto."
                                       FontSize="9"
                                       Foreground="#4B6178"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <Border Background="#FFF8E8"
                                    BorderBrush="#E3B341"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="7,5"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding MachineRuntimeAdjustmentOverview.HasValidationErrors, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding MachineRuntimeAdjustmentOverview.ValidationSummary}"
                                           Foreground="#805A00"
                                           FontSize="10"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel Visibility="{Binding CanShowTopPositionAdjustment, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145"/>
                                        <ColumnDefinition Width="*"/>
