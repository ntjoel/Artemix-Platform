                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,8,0,8"
                                    Opacity="{Binding CurrentRecipeData.inspectionStatus.ThreeDLength, Converter={StaticResource BooleanToOpacityConverter}}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8" VerticalAlignment="Center"
                                               FontWeight="Bold" Text="Lunghezza 3D:" x:Name="Sub_entry_ThreeDLengthLabel"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Margin="0,0,0,4" x:Name="Sub_entry_Top3DNominalLabel3" Text="Nominale"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="45"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         MinWidth="90"
                                                         Text="{Binding CurrentRecipeData.general_Info.Product_Length, StringFormat='{}{0:0.00}', Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         ToolTip="Valore propagato dalle proprietà prodotto"/>
                                                <TextBlock Grid.Column="1" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,4" x:Name="Sub_entry_Top3DToleranceLabel3" Text="Tolleranza"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="55"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         MinWidth="90"
                                                         Text="{Binding CurrentRecipeData.recipeParamTop3D.ThreeDLengthTolerance, StringFormat='{}{0:0.00}', UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="TextBox_TextChanged"
                                                         IsEnabled="{Binding CanEditTolerances}"/>
                                                <TextBlock Grid.Column="1" Text="± mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                             </Border>

                            <Border Margin="0,8,0,0"
                                    Padding="10"
                                    Background="#F4F8FC"
                                    BorderBrush="#C7D8E7"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock x:Name="Sub_entry_Top3DProfileTitle"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="#17324B"
                                                   Text="Top3D profile"/>
                                        <CheckBox x:Name="Sub_entry_Top3DProfileEnableLabel"
                                                  DockPanel.Dock="Right"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Content="Enable monitoring"
                                                  IsChecked="{Binding CurrentRecipeData.recipeParamTop3D.ThreeDProfileEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="InspectionCheckBox_Changed"
                                                  Unchecked="InspectionCheckBox_Changed"
                                                  IsEnabled="{Binding CanEditRecipe}"/>
                                    </DockPanel>

                                    <TextBlock x:Name="Sub_entry_Top3DProfileDescription"
                                               Margin="0,6,0,10"
                                               FontSize="10"
                                               Foreground="#5A7088"
                                               TextWrapping="Wrap"
                                               Text="Bulge index = High Tail - Median across the full ROI. It does not locate the defect and never commands physical reject in this baseline."/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="Sub_entry_Top3DMinimumValidPixelsLabel"
                                                       Margin="0,0,0,4"
                                                       Text="Minimum valid pixels"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         MinWidth="78"
                                                         Text="{Binding ThreeDProfileMinimumValidPixelsPercent, Converter={StaticResource DecimalTextBoxConverter}, UpdateSourceTrigger=LostFocus}"
                                                         TextChanged="TextBox_TextChanged"
                                                         IsEnabled="{Binding CanEditTolerances}"/>
                                                <TextBlock Grid.Column="1"
                                                           Margin="5,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="%"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="Sub_entry_Top3DMaximumBulgeLabel"
                                                       Margin="0,0,0,4"
                                                       Text="Maximum bulge index"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         MinWidth="78"
                                                         Text="{Binding CurrentRecipeData.recipeParamTop3D.ThreeDHeightMaximumBulge, Converter={StaticResource DecimalTextBoxConverter}, UpdateSourceTrigger=LostFocus}"
                                                         TextChanged="TextBox_TextChanged"
                                                         IsEnabled="{Binding CanEditTolerances}"/>
                                                <TextBlock Grid.Column="1"
                                                           Margin="5,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="mm"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,8,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Margin="0,0,10,8"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Text="Top3D primary view:"
                                               x:Name="Sub_entry_Top3DPrimaryViewLabel"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Margin="0,0,0,8"
                                             Text="{Binding CurrentRecipeData.recipeParamTop3D.Top3DPrimaryLastRunView, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditRecipe}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Text="Top2D secondary view:"
                                               x:Name="Sub_entry_Top3DSecondaryViewLabel"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding CurrentRecipeData.recipeParamTop3D.Top3DSecondaryLastRunView, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditRecipe}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    <!-- Quick Actions -->
                    <GroupBox Grid.Row="9" Header="Azioni Rapide" Name="Sub_entry_Rapid_action">
                        <StackPanel>

                            <Button Content="🔍 Verifica Integrità" Margin="0,5" Name="Sub_entry_Check_Integrity_Button"
                                    Click="CheckIntegrity_Click"
                                    Background="#17324B"
                                    BorderBrush="#102334"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
    </Grid>
</UserControl>
