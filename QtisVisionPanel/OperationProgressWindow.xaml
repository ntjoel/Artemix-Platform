<Window x:Class="QtisVisionPanel.OperationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="Operation in progress"
        Width="560"
        Height="230"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#10253C"
            CornerRadius="18"
            BorderBrush="#3B7EB8"
            BorderThickness="2">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">
                <Border Width="54"
                        Height="54"
                        CornerRadius="27"
                        Background="#173B5C">
                    <fa:ImageAwesome Icon="Cogs"
                                     Spin="True"
                                     Foreground="#F4F8FB"
                                     Width="28"
                                     Height="28"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="OperationTitleText"
                               Text="Operation in progress"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="OperationStatusText"
                               Text="Preparing operation..."
                               Foreground="#D0E0EE"
                               FontSize="14"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       x:Name="OperationDetailText"
                       Text="Please wait while the system completes the requested task."
                       Foreground="#9EB8CF"
                       FontSize="13"
                       Margin="0,18,0,0"
                       TextWrapping="Wrap"/>

            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Background="#17324A"
                    CornerRadius="12"
                    Padding="14">
                <StackPanel>
                    <TextBlock x:Name="OperationPhaseText"
                               Text="Runtime operation"
                               Foreground="#F0F6FB"
                               FontSize="13"
                               FontWeight="SemiBold"/>

                    <ProgressBar x:Name="OperationProgressBar"
                                 Height="16"
                                 Margin="0,12,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#38A169"
                                 Background="#24425F"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3"
                       x:Name="OperationProgressText"
                       Text="0%"
                       Foreground="#E9F2F9"
                       FontSize="13"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       Margin="0,12,0,0"/>
        </Grid>
    </Border>
</Window>
