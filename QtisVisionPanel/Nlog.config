<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn">
  <!--
    Ogni destinazione usa un AsyncWrapper esplicito: il thread che chiama il logger si
    limita a mettere in coda l'evento, la scrittura avviene su un worker NLog.

    Perche' e' necessario: AddLogEntry (DigitalIOViewModel) e OnLogMessage vengono invocati
    dal THREAD DI POLLING I/O, quello che legge encoder e input ogni 2 ms. In configurazione
    sincrona un singolo WARN da quel thread costava, in fila:
      - errorfile  -> mutex inter-processo + open + write + flush + close
      - jsonfile   -> idem
      - dbbridge   -> JsonConvert.SerializeObject + INSERT MySQL sincrona (NLogEventBridge.Write)
    Con il disco occupato dal salvataggio delle immagini pezzo, questo produceva
    IO_POLL_OVERRUN fino a work=65 ms e trigger camera in ritardo di 150-300 count
    (20-40 mm sul prodotto).

    Il caso peggiore era auto-alimentante: il messaggio
    "[TRACK] Trigger request executed ... late=+306 counts" e' esso stesso un WARN, quindi il
    log del ritardo bloccava il thread e faceva arrivare in ritardo il trigger successivo.

    Tutte le code raggiungibili dal runtime macchina usano Discard: anche un evento audit o
    WARN puo' partire dal polling encoder o dall'esecutore trigger e non deve mai attendere
    disco o database. Le soglie restano bounded per impedire crescita illimitata della RAM.
  -->
  <targets>

    <!-- Log applicazione generale (INFO+): rotazione giornaliera, max 30 file, max 50 MB ciascuno -->
    <target xsi:type="AsyncWrapper" name="appfile" queueLimit="20000" overflowAction="Discard" batchSize="200">
      <target xsi:type="File"
              fileName="D:/QtisVision/Debug/logs/app.log"
              layout="${longdate}|${uppercase:${level}}|${logger}|${message}|${exception:format=ToString}"
              keepFileOpen="true"
              concurrentWrites="true"
              archiveFileName="D:/QtisVision/Debug/logs/Archives/app_{#}.log"
              archiveEvery="Day"
              archiveNumbering="Date"
              archiveDateFormat="yyyyMMdd"
              maxArchiveFiles="10"
              maxArchiveDays="10" />
    </target>

    <!-- Log eventi audit (INFO+): rotazione giornaliera, max 90 file -->
    <target xsi:type="AsyncWrapper" name="auditfile" queueLimit="20000" overflowAction="Discard" batchSize="200">
      <target xsi:type="File"
              fileName="D:/QtisVision/Debug/logs/event-audit.log"
              layout="${longdate}|${uppercase:${level}}|${logger}|${event-properties:item=log_id}|${message}|${event-properties:item=payload_json}"
              keepFileOpen="true"
              concurrentWrites="true"
              archiveFileName="D:/QtisVision/Debug/logs/Archives/audit_{#}.log"
              archiveEvery="Day"
              archiveNumbering="Date"
              archiveDateFormat="yyyyMMdd"
              maxArchiveFiles="10"
              maxArchiveDays="10" />
    </target>

    <!-- Log errori (WARN+): rotazione giornaliera, max 60 file -->
    <target xsi:type="AsyncWrapper" name="errorfile" queueLimit="20000" overflowAction="Discard" batchSize="200">
      <target xsi:type="File"
              fileName="D:/QtisVision/Debug/logs/errors.log"
              layout="${longdate}|${uppercase:${level}}|${logger}|${message}|${exception:format=ToString}"
              keepFileOpen="true"
              concurrentWrites="true"
              archiveFileName="D:/QtisVision/Debug/logs/Archives/errors_{#}.log"
              archiveEvery="Day"
              archiveNumbering="Date"
              archiveDateFormat="yyyyMMdd"
              maxArchiveFiles="10"
              maxArchiveDays="10" />
    </target>

    <!-- Log eventi strutturati JSON (WARN+): per query programmatiche e analisi offline -->
    <target xsi:type="AsyncWrapper" name="jsonfile" queueLimit="10000" overflowAction="Discard" batchSize="200">
      <target xsi:type="File"
              fileName="D:/QtisVision/Debug/logs/events.json"
              archiveFileName="D:/QtisVision/Debug/logs/Archives/events_{#}.json"
              archiveEvery="Day"
              archiveNumbering="Date"
              archiveDateFormat="yyyyMMdd"
              maxArchiveFiles="90"
              maxArchiveDays="90"
              keepFileOpen="true"
              concurrentWrites="true">
        <layout xsi:type="JsonLayout" includeAllProperties="true">
          <attribute name="ts"      layout="${longdate}" />
          <attribute name="level"   layout="${level}" />
          <attribute name="logger"  layout="${logger:shortName=true}" />
          <attribute name="msg"     layout="${message}" />
          <attribute name="ex"      layout="${exception:format=ToString}" encode="false" />
        </layout>
      </target>
    </target>

    <!-- Diagnostica per camera fisica (logger Camera.top / Camera.left / Camera.right /
         Camera.rear / Camera.front / Camera.bottom): un file per camera con l'intera catena
         quota -> ticket -> fronte -> risultato. Le stesse righe finiscono anche in app.log. -->
    <target xsi:type="AsyncWrapper" name="camerafile" queueLimit="20000" overflowAction="Discard" batchSize="200">
      <target xsi:type="File"
              fileName="D:/QtisVision/Debug/logs/camera-${logger:shortName=true}.log"
              layout="${longdate}|${uppercase:${level}}|${message}|${exception:format=ToString}"
              keepFileOpen="true"
              concurrentWrites="true"
              archiveFileName="D:/QtisVision/Debug/logs/Archives/camera-${logger:shortName=true}_{#}.log"
              archiveEvery="Day"
              archiveNumbering="Date"
              archiveDateFormat="yyyyMMdd"
              maxArchiveFiles="10"
              maxArchiveDays="10" />
    </target>

    <!-- Bridge verso database (eventi applicativi) -->
    <target xsi:type="AsyncWrapper" name="dbbridge" queueLimit="2000" overflowAction="Discard" batchSize="200">
      <target xsi:type="MethodCall"
              className="QtisVisionPanel.Services.NLogEventBridge, QtisVisionPanel"
              methodName="Write">
        <parameter layout="${logger}" />
        <parameter layout="${level}" />
        <parameter layout="${event-properties:item=log_id}" />
        <parameter layout="${message}" />
        <parameter layout="${exception:format=tostring}" />
        <parameter layout="${event-properties:item=payload_json}" />
      </target>
    </target>

  </targets>

  <rules>
    <!-- Logger audit: solo eventi strutturati da ApplicationEventLogger -->
    <logger name="EventAudit" minlevel="Info"  writeTo="auditfile" />
    <logger name="EventAudit" minlevel="Warn"  writeTo="errorfile" final="true" />

    <!-- Diagnostica per camera: file dedicato, NON final (prosegue verso appfile/errorfile) -->
    <logger name="Camera.*" minlevel="Info" writeTo="camerafile" />

    <!-- Tutti i logger: INFO -> appfile, WARN+ -> errorfile + dbbridge + jsonfile -->
    <logger name="*" minlevel="Info"  writeTo="appfile" />
    <logger name="*" minlevel="Warn"  writeTo="errorfile,dbbridge,jsonfile" />
  </rules>
</nlog>
